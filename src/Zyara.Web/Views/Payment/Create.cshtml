@model Zyara.Services.Features.Payments.Dtos.PaymentDto

@{
    ViewData["Title"] = "Select Payment Method";
}

<div class="container py-5" style="max-width: 560px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom text-center py-4">
            <h4 class="mb-1 text-primary fw-bold">Payment Method</h4>
            <p class="text-muted small mb-0">Booking Reference #@Model.BookingId</p>
        </div>
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded-3">
                <span class="text-secondary fw-semibold">Total Amount Due</span>
                <span class="fs-4 fw-bold text-dark">@Model.TotalPrice.ToString("N2") EGP</span>
            </div>

            <h6 class="fw-bold text-secondary mb-3">Choose how to pay:</h6>

            <!-- خيار الدفع بالفيزا / البطاقة -->
            <div class="border rounded-4 p-3 mb-3 bg-white shadow-xs">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-credit-card-2-front-fill fs-4 text-primary"></i>
                        <div>
                            <strong class="d-block">Credit / Debit Card (Visa)</strong>
                            <small class="text-muted">Instant, secure online checkout</small>
                        </div>
                    </div>
                    <span class="badge bg-primary-subtle text-primary">Instant</span>
                </div>
                <form asp-controller="CardPayment" asp-action="Checkout" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
                        <i class="bi bi-lock-fill me-1"></i> Pay Online with Card
                    </button>
                </form>
            </div>

            <!-- خيار الدفع كاش عند الوصول -->
            <div class="border rounded-4 p-3 bg-light">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-cash-stack fs-4 text-success"></i>
                        <div>
                            <strong class="d-block">Cash on Arrival</strong>
                            <small class="text-muted">Pay in cash directly to provider</small>
                        </div>
                    </div>
                </div>
                <form asp-controller="Payment" asp-action="Create" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                    <button type="submit" class="btn btn-outline-success w-100 rounded-pill py-2">
                        Confirm Cash on Arrival
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>