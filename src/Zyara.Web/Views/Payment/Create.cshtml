@model Zyara.Services.Features.Payments.Dtos.PaymentDto

@{
    ViewData["Title"] = "Confirm Payment";
}

<div class="container py-5" style="max-width: 520px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom text-center py-4">
            <h4 class="mb-1 text-primary fw-bold">Select Payment</h4>
            <p class="text-muted small mb-0">Booking Reference #@Model.BookingId</p>
        </div>
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded-3">
                <span class="text-secondary fw-semibold">Payment Method</span>
                <span class="badge bg-success-subtle text-success fs-6 px-3 py-2">
                    <i class="bi bi-cash me-1"></i> @Model.Method
                </span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded-3">
                <span class="text-secondary fw-semibold">Total Amount Due</span>
                <span class="fs-4 fw-bold text-dark">@Model.TotalPrice.ToString("N2") EGP</span>
            </div>

            <div class="alert alert-warning small d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-info-circle-fill fs-5"></i>
                <span>You will pay in cash to the provider directly upon arrival at the scheduled appointment time.</span>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@Model.BookingId" />

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                        Confirm Cash on Arrival
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>