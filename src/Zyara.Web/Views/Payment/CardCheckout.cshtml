@model Zyara.Services.Features.Payments.Dtos.CardCheckoutDto
@{
    ViewData["Title"] = "Card payment";
}

<div class="container py-5" style="max-width: 480px;">
    <div class="alert alert-info small border-0 rounded-4">
        <strong>Demo payment page.</strong> This stands in for the payment gateway's own page.
        Use the test card <code>4242 4242 4242 4242</code>. No real money is charged.
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <h1 class="h4 fw-bold mb-1">Pay by card</h1>
            <p class="text-muted small mb-4">Booking #@Model.BookingId</p>

            <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded-3">
                <span class="text-secondary fw-semibold">Amount</span>
                <span class="fs-4 fw-bold">@Model.Amount.ToString("N2") EGP</span>
            </div>

            <form asp-controller="CardPayment" asp-action="HostedPage" method="post" autocomplete="off">
                <input type="hidden" name="reference" value="@Model.Reference" />

                <div class="mb-4">
                    <label for="cardNumber" class="form-label">Card number</label>
                    <input id="cardNumber" name="cardNumber" class="form-control form-control-lg" inputmode="numeric"
                           autocomplete="cc-number" placeholder="4242 4242 4242 4242" maxlength="23" required />
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill">Pay @Model.Amount.ToString("N2") EGP</button>
                    <a asp-controller="Payment" asp-action="Create" asp-route-bookingId="@Model.BookingId" class="btn btn-link">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
