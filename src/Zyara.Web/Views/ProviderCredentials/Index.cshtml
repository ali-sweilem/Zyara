@model List<ProviderCredentialDto>
@{
    ViewData["Title"] = "My Credentials";
}

<div class="container py-4" style="max-width: 960px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-primary fw-semibold small mb-1">Provider Portal</p>
            <h1 class="h3 fw-bold mb-1"><i class="bi bi-folder2-open me-2 text-primary"></i>My Credentials</h1>
            <p class="text-muted mb-0">Upload and manage the documents used for verification.</p>
        </div>
        <a asp-controller="Providers" asp-action="showprofile" class="btn btn-outline-primary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i>Back to Profile
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3">@TempData["Success"]</div>
    }

    <div class="card border rounded-3 bg-white mb-4">
        <div class="card-body p-4">
            <h2 class="h6 fw-bold mb-3"><i class="bi bi-cloud-upload me-2 text-primary"></i>Upload a new document</h2>
            <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold small" for="DocumentType">Document type</label>
                    <select id="DocumentType" name="DocumentType" class="form-select" required>
                        <option value="">Select document type</option>
                        <option>Medical License</option>
                        <option>Graduation Certificate</option>
                        <option>National ID</option>
                        <option>Other</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold small" for="File">Choose file <span class="text-muted fw-normal">(PDF / JPG / PNG, max 5 MB)</span></label>
                    <input id="File" type="file" name="File" accept=".pdf,.jpg,.jpeg,.png" class="form-control" required />
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary rounded-pill"><i class="bi bi-upload me-1"></i> Upload</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border rounded-3 bg-white overflow-hidden">
        <div class="card-header bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
            <h2 class="h5 fw-bold mb-0"><i class="bi bi-files me-2 text-primary"></i>Uploaded Documents</h2>
            <span class="badge bg-light text-secondary border rounded-pill px-3 py-1">@Model.Count files</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">No documents uploaded yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 bookings-table">
                        <thead>
                            <tr>
                                <th class="ps-4">Document</th>
                                <th>Format</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">@c.DocumentType</td>
                                    <td class="text-muted small">@c.FileExtension</td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Download" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                                            <i class="bi bi-eye me-1"></i> Open
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
