@model ProviderProfileDto
@{
    ViewData["Title"] = "My Profile";
    var badge = Model.VerificationStatus switch
    {
        VerificationStatus.Pending => "badge-warning",
        VerificationStatus.Verified => "badge-success",
        VerificationStatus.Rejected => "badge-danger"
    };
}

<div class="container provider-page my-4">
    <div class="d-flex gap-2 mb-3">
        <a asp-controller="ProviderCredentials" asp-action="Index" asp-route-providerId="@Model.Id" class="btn btn-outline-primary rounded-pill px-3"><i class="bi bi-folder2-open me-1"></i> My Documents</a>
        <a asp-controller="ProviderVerification" asp-action="Status" asp-route-providerId="@Model.Id" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-shield-check me-1"></i> Verification Status</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4" role="alert">@TempData["Success"]</div>
    }

    <div class="card provider-card overflow-hidden">
        <div class="provider-hero text-white p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <span class="badge bg-white bg-opacity-25 rounded-pill px-3 py-2 mb-3"><i class="bi bi-person-badge me-1"></i> Provider Profile</span>
                    <h1 class="h2 fw-bold mb-1">@Model.FullName</h1>
                    <p class="mb-0 text-white-50">@Model.Specialty</p>
                </div>
                <a asp-action="EditProfile" asp-route-id="@Model.Id" class="btn btn-light rounded-pill px-4 fw-semibold"><i class="bi bi-pencil-square me-1"></i> Edit Profile</a>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            @if (Model.VerificationStatus == VerificationStatus.Rejected && !string.IsNullOrEmpty(Model.RejectionReason))
            {
                <div class="alert alert-danger border-0 rounded-4 mb-4"><strong>Rejection Reason:</strong> @Model.RejectionReason</div>
            }

            <div class="row g-4 align-items-center mb-4">
                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
                    {
                        <img src="@Model.PhotoUrl" alt="Profile Image" class="provider-avatar rounded-circle">
                    }
                    else if (Model.Gender == Gender.Male)
                    {
                        <img src="https://png.pngtree.com/png-vector/20191110/ourlarge/pngtree-avatar-icon-profile-icon-member-login-vector-isolated-png-image_1978396.jpg" alt="Profile Image" class="provider-avatar rounded-circle">
                    }
                    else
                    {
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSQ4kPEee1SDUDrJeSfGiNMINVS82sdvmdlfZuSqgmp39EoEu8PoQXwXM0&s=10" alt="Profile Image" class="provider-avatar rounded-circle">
                    }
                    <div class="mt-3"><span class="badge @badge rounded-pill px-3 py-2">@Model.VerificationStatus</span></div>
                </div>
                <div class="col-md-8">
                    <div class="row g-3">
                        <div class="col-sm-6"><div class="provider-detail"><div class="provider-detail-label">Email</div><div class="fw-semibold">@Model.Email</div></div></div>
                        <div class="col-sm-6"><div class="provider-detail"><div class="provider-detail-label">Phone</div><div class="fw-semibold">@Model.Phone</div></div></div>
                        <div class="col-sm-6"><div class="provider-detail"><div class="provider-detail-label">Gender</div><div class="fw-semibold">@((Gender)Model.Gender)</div></div></div>
                        <div class="col-sm-6"><div class="provider-detail"><div class="provider-detail-label">Base City</div><div class="fw-semibold">@Model.BaseCity</div></div></div>
                        <div class="col-sm-6"><div class="provider-detail"><div class="provider-detail-label">Experience</div><div class="fw-semibold">@Model.ExperienceYears years</div></div></div>
                        <div class="col-sm-6"><div class="provider-detail"><div class="provider-detail-label">Member Since</div><div class="fw-semibold">@Model.CreatedAt.ToString("MMM yyyy")</div></div></div>
                    </div>
                </div>
            </div>

            <div class="row g-3 border-top pt-4 text-center">
                <div class="col-md-4"><div class="h4 fw-bold text-primary mb-1">@Model.RatingCount</div><small class="text-muted">Ratings</small></div>
                <div class="col-md-4"><div class="h4 fw-bold text-primary mb-1">@Model.AverageRating.ToString("0.0") <i class="bi bi-star-fill text-warning fs-6"></i></div><small class="text-muted">Average Rating</small></div>
                <div class="col-md-4"><div class="h4 fw-bold text-primary mb-1">@Model.WalletBalance.ToString("N2")</div><small class="text-muted">Wallet Balance</small></div>
            </div>
        </div>
    </div>
</div>