@using Zyara.Services.Features.Shared
@model Zyara.Services.Features.Providers.Dtos.ProviderDetailsPageDto

@{
    var provider = Model.Provider;
    var reviewPage = Model.Reviews;
    var roleLabel = provider.Role == UserRole.Nurse ? "Nurse" : "Doctor";
    ViewData["Title"] = $"{provider.FullName} — {roleLabel}";

    var egyptToday = EgyptTime.Now(TimeProvider.System).Date;
    var slotDays = provider.UpcomingSlots
        .GroupBy(slot => slot.Date.Date)
        .OrderBy(g => g.Key)
        .ToList();
    var firstService = provider.Services.FirstOrDefault();
    var canBook = provider.IsAvailable && provider.Services.Any() && slotDays.Any();
}

<div class="container py-4">
    <div class="mb-3">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i>Back to providers
        </a>
    </div>

    <div class="row g-4 align-items-start">

        @* ═══════════════════════════════════════════════════════════════
           LEFT COLUMN: Provider Profile, Bio, Services & Reviews
           ═══════════════════════════════════════════════════════════════ *@
        <main class="col-lg-7">

            @* ── Provider Header ── *@
            <section class="card border rounded-3 bg-white mb-4">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start gap-3">
                        @await Html.PartialAsync("_Avatar", new AvatarDto
                        {
                            FullName = provider.FullName,
                            PhotoUrl = provider.PhotoUrl,
                            Id = provider.Id,
                            Size = 96
                        })
                        <div class="text-center text-sm-start flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-sm-between gap-2 mb-1">
                                <h1 class="h3 fw-bold mb-0">@provider.FullName</h1>
                                @if (provider.IsAvailable)
                                {
                                    <span class="small text-success fw-medium">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i>Available
                                    </span>
                                }
                                else
                                {
                                    <span class="small text-muted">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i>Unavailable
                                    </span>
                                }
                            </div>

                            <p class="text-muted mb-2">
                                @roleLabel@(!string.IsNullOrWhiteSpace(provider.Specialty) ? $" · {provider.Specialty}" : "")
                            </p>

                            <div class="small text-muted d-flex flex-wrap justify-content-center justify-content-sm-start gap-3">
                                @if (provider.ExperienceYears > 0)
                                {
                                    <span><i class="bi bi-briefcase me-1"></i>@provider.ExperienceYears yrs experience</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(provider.BaseCity))
                                {
                                    <span><i class="bi bi-geo-alt me-1"></i>@provider.BaseCity</span>
                                }
                                @if (provider.RatingCount > 0)
                                {
                                    <span>
                                        <i class="bi bi-star-fill text-warning me-1"></i><strong class="text-dark">@provider.AverageRating.ToString("0.0")</strong> (@provider.RatingCount reviews)
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            @* ── About Section ── *@
            @if (!string.IsNullOrWhiteSpace(provider.Bio))
            {
                <section class="card border rounded-3 bg-white mb-4">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h5 fw-bold mb-2">About</h2>
                        <p class="mb-0 text-secondary" style="line-height: 1.65;">@provider.Bio</p>
                    </div>
                </section>
            }

            @* ── Services & Pricing ── *@
            <section class="card border rounded-3 bg-white mb-4">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="h5 fw-bold mb-0">Services &amp; Pricing</h2>
                        <span class="small text-muted">@provider.Services.Count listed</span>
                    </div>

                    @if (provider.Services.Count == 0)
                    {
                        <p class="text-muted small mb-0">No services are currently listed.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @for (int s = 0; s < provider.Services.Count; s++)
                            {
                                var service = provider.Services[s];
                                var isFirst = s == 0;
                                <div class="list-group-item px-0 py-3 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold text-dark">@service.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(service.Description))
                                        {
                                            <div class="small text-muted mt-1">@service.Description</div>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-3 flex-shrink-0">
                                        <span class="fw-bold text-dark">@service.Fee.ToString("N0") <small class="fw-normal text-muted">EGP</small></span>
                                        @if (canBook)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm rounded-2 choose-service-btn @(isFirst ? "btn-primary" : "btn-outline-secondary")"
                                                    data-service-id="@service.Id">
                                                @(isFirst ? "Selected" : "Select")
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>

            @* ── Patient Reviews ── *@
            <section id="reviews" class="card border rounded-3 bg-white">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <h2 class="h5 fw-bold mb-0">Patient Reviews</h2>
                        @if (provider.RatingCount > 0)
                        {
                            <span class="small text-muted">
                                <i class="bi bi-star-fill text-warning me-1"></i><strong class="text-dark">@provider.AverageRating.ToString("0.0")</strong> / 5 (@provider.RatingCount)
                            </span>
                        }
                    </div>

                    @if (reviewPage.Items.Count == 0)
                    {
                        <p class="text-muted small mb-0">No reviews yet for this provider.</p>
                    }
                    else
                    {
                        <div class="vstack gap-3">
                            @foreach (var review in reviewPage.Items)
                            {
                                <article class="border-bottom pb-3">
                                    <div class="d-flex gap-3">
                                        @await Html.PartialAsync("_Avatar", new AvatarDto
                                        {
                                            FullName = review.ReviewerName,
                                            PhotoUrl = null,
                                            Id = review.ReviewerName.GetHashCode(),
                                            Size = 36
                                        })
                                        <div class="flex-grow-1">
                                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                                <span class="fw-semibold text-dark">@review.ReviewerName</span>
                                                <time class="small text-muted" datetime="@review.CreatedAt.ToString("O")">@review.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</time>
                                            </div>
                                            <div class="text-warning small mb-1" aria-label="@review.Rating out of 5 stars">
                                                @for (var star = 0; star < review.Rating; star++)
                                                {
                                                    <i class="bi bi-star-fill"></i>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                                            {
                                                <p class="mb-0 text-break text-secondary small">@review.Comment</p>
                                            }
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>

                        @if (reviewPage.TotalPages > 1)
                        {
                            <nav class="mt-3" aria-label="Reviews pagination">
                                <ul class="pagination pagination-sm justify-content-center mb-0">
                                    @if (reviewPage.HasPreviousPage)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Details", "Providers", new { id = provider.Id, reviewsPage = reviewPage.PageNumber - 1 })#reviews">Previous</a>
                                        </li>
                                    }
                                    @for (var pageNumber = 1; pageNumber <= reviewPage.TotalPages; pageNumber++)
                                    {
                                        <li class="page-item @(pageNumber == reviewPage.PageNumber ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Details", "Providers", new { id = provider.Id, reviewsPage = pageNumber })#reviews">@pageNumber</a>
                                        </li>
                                    }
                                    @if (reviewPage.HasNextPage)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Details", "Providers", new { id = provider.Id, reviewsPage = reviewPage.PageNumber + 1 })#reviews">Next</a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </section>
        </main>

        @* ═══════════════════════════════════════════════════════════════
           RIGHT COLUMN: Appointment Booking Box
           ═══════════════════════════════════════════════════════════════ *@
        <aside class="col-lg-5">
            <div id="bookingWidgetCard" class="card border shadow-sm rounded-3 bg-white sticky-lg-top" style="top: 1.5rem; z-index: 10;">
                <div class="card-body p-3 p-md-4">
                    <h2 class="h5 fw-bold mb-1">Book an Appointment</h2>
                    <p class="small text-muted mb-3 pb-3 border-bottom">Choose a service, date, and time to request a visit.</p>

                    @if (!provider.IsAvailable)
                    {
                        <div class="alert alert-light border rounded-2 small text-muted mb-0">
                            This provider is not accepting new bookings at the moment.
                        </div>
                    }
                    else if (provider.Services.Count == 0)
                    {
                        <div class="alert alert-light border rounded-2 small text-muted mb-0">
                            No services are available to book right now.
                        </div>
                    }
                    else if (!slotDays.Any())
                    {
                        <div class="alert alert-light border rounded-2 small text-muted mb-0">
                            No upcoming time slots are available right now.
                        </div>
                    }
                    else
                    {
                        @* ── Service ── *@
                        <div class="mb-3">
                            <label for="bookingServiceSelect" class="form-label small fw-semibold text-dark">Service</label>
                            <select id="bookingServiceSelect" class="form-select rounded-2">
                                @for (int s = 0; s < provider.Services.Count; s++)
                                {
                                    var svc = provider.Services[s];
                                    <option value="@svc.Id"
                                            data-service-name="@svc.Name"
                                            data-service-fee="@svc.Fee"
                                            selected="@(s == 0)">
                                        @svc.Name — @svc.Fee.ToString("N0") EGP
                                    </option>
                                }
                            </select>
                        </div>

                        @* ── Date ── *@
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="form-label small fw-semibold text-dark mb-0">Date</span>
                                <span class="small text-muted" id="selectedDateDisplayTitle">@slotDays.First().Key.ToString("ddd, d MMM yyyy")</span>
                            </div>
                            <div class="d-flex gap-2 overflow-auto pb-2" id="calendarDaysStrip" style="scrollbar-width: thin;">
                                @for (int d = 0; d < slotDays.Count; d++)
                                {
                                    var day = slotDays[d];
                                    var isSelectedDay = d == 0;
                                    var dateObj = day.Key;
                                    var isToday = dateObj.Date == egyptToday;
                                    var isTomorrow = dateObj.Date == egyptToday.AddDays(1);
                                    var dayName = isToday ? "Today" : (isTomorrow ? "Tomorrow" : dateObj.ToString("ddd"));

                                    <button type="button"
                                            class="calendar-date-card btn text-center px-2 py-2 rounded-2 border flex-shrink-0 @(isSelectedDay ? "btn-primary text-white border-primary" : "btn-light bg-white text-dark")"
                                            data-day-index="@d"
                                            data-date-display="@dateObj.ToString("ddd, d MMM yyyy")"
                                            style="min-width: 78px;">
                                        <span class="d-block small @(isSelectedDay ? "text-white-50" : "text-muted")" style="font-size: 0.75rem;">@dayName</span>
                                        <span class="d-block fw-bold my-1" style="font-size: 0.9rem;">@dateObj.ToString("d MMM")</span>
                                        <span class="d-block @(isSelectedDay ? "text-white-50" : "text-muted")" style="font-size: 0.7rem;">
                                            @day.Count() @(day.Count() == 1 ? "slot" : "slots")
                                        </span>
                                    </button>
                                }
                            </div>
                        </div>

                        @* ── Time Slots ── *@
                        <div class="mb-4">
                            <span class="form-label small fw-semibold text-dark d-block mb-2">Available Times</span>
                            @for (int d = 0; d < slotDays.Count; d++)
                            {
                                var day = slotDays[d];
                                var isSelectedDay = d == 0;
                                <div class="day-slots-panel @(isSelectedDay ? "" : "d-none")" data-day-index="@d">
                                    <div class="row row-cols-2 g-2">
                                        @foreach (var slot in day)
                                        {
                                            <div class="col">
                                                <button type="button"
                                                        class="btn btn-outline-secondary btn-sm w-100 rounded-2 time-slot-pill py-2"
                                                        data-slot-id="@slot.Id"
                                                        data-slot-label="@day.Key.ToString("ddd d MMM"), @slot.StartTime.ToString(@"hh\:mm") – @slot.EndTime.ToString(@"hh\:mm")">
                                                    @slot.StartTime.ToString(@"hh\:mm") – @slot.EndTime.ToString(@"hh\:mm")
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        @* ── Summary & CTA ── *@
                        <div class="border-top pt-3">
                            <div class="d-flex justify-content-between align-items-center small mb-3">
                                <span class="text-muted" id="summarySlotText">Select a time slot above</span>
                                <span class="fw-bold text-dark" id="summaryFeeText">@(firstService != null ? $"{firstService.Fee:N0} EGP" : "")</span>
                            </div>

                            <a id="proceedToBookBtn"
                               href="@Url.Action("Book", "Booking", new { providerId = provider.Id, serviceId = firstService?.Id })"
                               aria-disabled="true"
                               class="btn btn-primary w-100 rounded-2 py-2 fw-semibold disabled">
                                Select a time slot
                            </a>

                            <div class="text-center small text-muted mt-2">
                                Your request will be confirmed by the provider.
                            </div>
                        </div>
                    }
                </div>
            </div>
        </aside>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const providerId = '@provider.Id';
            const serviceSelect = document.getElementById('bookingServiceSelect');
            const summarySlotText = document.getElementById('summarySlotText');
            const summaryFeeText = document.getElementById('summaryFeeText');
            const proceedToBookBtn = document.getElementById('proceedToBookBtn');
            const selectedDateDisplayTitle = document.getElementById('selectedDateDisplayTitle');

            if (!serviceSelect || !proceedToBookBtn) return;

            let selectedServiceId = serviceSelect.value;
            let selectedServiceFeeNum = parseFloat(serviceSelect.selectedOptions[0]?.dataset.serviceFee) || 0;
            let selectedSlotId = null;

            function formatFee(num) {
                return num.toLocaleString('en-US') + ' EGP';
            }

            function syncLeftServiceButtons() {
                document.querySelectorAll('.choose-service-btn').forEach(btn => {
                    const isMatch = btn.dataset.serviceId === selectedServiceId;
                    btn.classList.toggle('btn-primary', isMatch);
                    btn.classList.toggle('btn-outline-secondary', !isMatch);
                    btn.textContent = isMatch ? 'Selected' : 'Select';
                });
            }

            function updateBookingUrl() {
                let url = '@Url.Action("Book", "Booking")?providerId=' + encodeURIComponent(providerId);
                if (selectedServiceId && selectedServiceId !== '0') {
                    url += '&serviceId=' + encodeURIComponent(selectedServiceId);
                }
                if (selectedSlotId) {
                    url += '&slotId=' + encodeURIComponent(selectedSlotId);
                    proceedToBookBtn.classList.remove('disabled');
                    proceedToBookBtn.removeAttribute('aria-disabled');
                    proceedToBookBtn.textContent = 'Continue to Booking · ' + formatFee(selectedServiceFeeNum);
                } else {
                    proceedToBookBtn.classList.add('disabled');
                    proceedToBookBtn.setAttribute('aria-disabled', 'true');
                    proceedToBookBtn.textContent = 'Select a time slot';
                }
                proceedToBookBtn.href = url;
            }

            // Guard against keyboard activation when no slot is selected
            proceedToBookBtn.addEventListener('click', function (e) {
                if (!selectedSlotId) {
                    e.preventDefault();
                }
            });

            // 1. Service selection (sidebar dropdown <-> left list buttons)
            serviceSelect.addEventListener('change', function () {
                const opt = this.selectedOptions[0];
                selectedServiceId = this.value;
                selectedServiceFeeNum = parseFloat(opt?.dataset.serviceFee) || 0;

                if (summaryFeeText) summaryFeeText.textContent = formatFee(selectedServiceFeeNum);
                syncLeftServiceButtons();
                updateBookingUrl();
            });

            document.querySelectorAll('.choose-service-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    serviceSelect.value = this.dataset.serviceId;
                    serviceSelect.dispatchEvent(new Event('change'));
                    document.getElementById('bookingWidgetCard')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            });

            // 2. Calendar date strip
            const dateCards = document.querySelectorAll('.calendar-date-card');
            const dayPanels = document.querySelectorAll('.day-slots-panel');

            dateCards.forEach(card => {
                card.addEventListener('click', function () {
                    const dayIndex = this.dataset.dayIndex;
                    const dateDisplay = this.dataset.dateDisplay;

                    dateCards.forEach(c => {
                        c.classList.remove('btn-primary', 'text-white', 'border-primary');
                        c.classList.add('btn-light', 'bg-white', 'text-dark');
                        c.querySelectorAll('span:first-child, span:last-child').forEach(s => {
                            s.classList.remove('text-white-50');
                            s.classList.add('text-muted');
                        });
                    });

                    this.classList.remove('btn-light', 'bg-white', 'text-dark');
                    this.classList.add('btn-primary', 'text-white', 'border-primary');
                    this.querySelectorAll('span:first-child, span:last-child').forEach(s => {
                        s.classList.remove('text-muted');
                        s.classList.add('text-white-50');
                    });

                    dayPanels.forEach(p => {
                        p.classList.toggle('d-none', p.dataset.dayIndex !== dayIndex);
                    });

                    if (selectedDateDisplayTitle) {
                        selectedDateDisplayTitle.textContent = dateDisplay;
                    }
                });
            });

            // 3. Time slot selection
            document.querySelectorAll('.time-slot-pill').forEach(pill => {
                pill.addEventListener('click', function () {
                    document.querySelectorAll('.time-slot-pill').forEach(p => {
                        p.classList.remove('btn-primary', 'text-white');
                        p.classList.add('btn-outline-secondary');
                    });

                    this.classList.remove('btn-outline-secondary');
                    this.classList.add('btn-primary', 'text-white');

                    selectedSlotId = this.dataset.slotId;

                    if (summarySlotText) {
                        summarySlotText.textContent = this.dataset.slotLabel;
                        summarySlotText.classList.remove('text-muted');
                        summarySlotText.classList.add('text-dark', 'fw-medium');
                    }

                    updateBookingUrl();
                });
            });

            updateBookingUrl();
        });
    </script>
}
