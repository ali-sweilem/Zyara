@model Zyara.Web.Models.ProviderDetailsViewModel
@using Zyara.Domain.Enums

@{
    var provider = Model.Provider;
    var reviewPage = Model.Reviews;
    var roleLabel = provider.Role == UserRole.Nurse ? "Nurse" : "Doctor";
    var slotDays = provider.UpcomingSlots.GroupBy(slot => slot.Date.Date);
}

<div class="container py-4 py-lg-5">
    <div class="row g-4 align-items-start">
        <main class="col-lg-8">
            <section class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start gap-4">
                        @await Html.PartialAsync("_Avatar", new AvatarViewModel
                        {
                            FullName = provider.FullName,
                            PhotoUrl = provider.PhotoUrl,
                            Id = provider.Id,
                            Size = 112
                        })
                        <div class="text-center text-sm-start flex-grow-1">
                            <div class="d-flex flex-wrap justify-content-center justify-content-sm-start gap-2 mb-2">
                                <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill">@roleLabel</span>
                                @if (provider.IsAvailable)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill">Currently unavailable</span>
                                }
                            </div>
                            <h1 class="h2 fw-bold mb-1">@provider.FullName</h1>
                            <p class="text-muted mb-2">@(string.IsNullOrWhiteSpace(provider.Specialty) ? roleLabel : provider.Specialty)</p>
                            <div class="small text-muted d-flex flex-wrap justify-content-center justify-content-sm-start gap-3">
                                @if (provider.ExperienceYears > 0)
                                {
                                    <span><i class="bi bi-award me-1 text-primary"></i>@provider.ExperienceYears years experience</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(provider.BaseCity))
                                {
                                    <span><i class="bi bi-geo-alt me-1 text-danger"></i>@provider.BaseCity</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(provider.Bio))
            {
                <section class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 p-md-5">
                        <h2 class="h4 fw-bold mb-3">About</h2>
                        <p class="mb-0 text-break">@provider.Bio</p>
                    </div>
                </section>
            }

            <section class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">
                    <h2 class="h4 fw-bold mb-3">Services</h2>
                    @if (provider.Services.Count == 0)
                    {
                        <div class="alert alert-light border mb-0">No services are currently listed.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var service in provider.Services)
                            {
                                <div class="list-group-item px-0 d-flex flex-column flex-sm-row justify-content-between gap-3">
                                    <div>
                                        <h3 class="h6 fw-bold mb-1">@service.Name</h3>
                                        @if (!string.IsNullOrWhiteSpace(service.Description))
                                        {
                                            <p class="small text-muted mb-0 text-break">@service.Description</p>
                                        }
                                    </div>
                                    <div class="fw-semibold text-nowrap">@service.Fee.ToString("N0") EGP</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>

            <section id="reviews" class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <h2 class="h4 fw-bold mb-0">Reviews</h2>
                        @if (provider.RatingCount > 0)
                        {
                            <span class="text-warning" aria-label="@provider.AverageRating.ToString("0.0") out of 5 stars">
                                <i class="bi bi-star-fill"></i> @provider.AverageRating.ToString("0.0") (@provider.RatingCount)
                            </span>
                        }
                    </div>

                    @if (reviewPage.Items.Count == 0)
                    {
                        <div class="alert alert-light border mb-0">No reviews yet.</div>
                    }
                    else
                    {
                        <div class="vstack gap-3">
                            @foreach (var review in reviewPage.Items)
                            {
                                <article class="border-bottom pb-3">
                                    <div class="d-flex gap-3">
                                        @await Html.PartialAsync("_Avatar", new AvatarViewModel
                                        {
                                            FullName = review.ReviewerName,
                                            PhotoUrl = null,
                                            Id = review.ReviewerName.GetHashCode(),
                                            Size = 40
                                        })
                                        <div class="flex-grow-1">
                                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                                <h3 class="h6 fw-bold mb-1">@review.ReviewerName</h3>
                                                <time class="small text-muted" datetime="@review.CreatedAt.ToString("O")">@review.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</time>
                                            </div>
                                            <div class="text-warning small mb-2" aria-label="@review.Rating out of 5 stars">
                                                @for (var star = 0; star < review.Rating; star++)
                                                {
                                                    <i class="bi bi-star-fill"></i>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                                            {
                                                <p class="mb-0 text-break">@review.Comment</p>
                                            }
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>

                        @if (reviewPage.TotalPages > 1)
                        {
                            <nav class="mt-4" aria-label="Reviews pagination">
                                <ul class="pagination justify-content-center mb-0">
                                    @if (reviewPage.HasPreviousPage)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Details", "Providers", new { id = provider.Id, reviewsPage = reviewPage.PageNumber - 1 })#reviews">Previous</a>
                                        </li>
                                    }
                                    @for (var pageNumber = 1; pageNumber <= reviewPage.TotalPages; pageNumber++)
                                    {
                                        <li class="page-item @(pageNumber == reviewPage.PageNumber ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Details", "Providers", new { id = provider.Id, reviewsPage = pageNumber })#reviews">@pageNumber</a>
                                        </li>
                                    }
                                    @if (reviewPage.HasNextPage)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Details", "Providers", new { id = provider.Id, reviewsPage = reviewPage.PageNumber + 1 })#reviews">Next</a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </section>
        </main>

        <aside class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-lg-top" style="top: 1rem;">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3">Appointment information</h2>
                    <div class="border-bottom pb-3 mb-3">
                        <div class="small text-muted">Starting price</div>
                        @if (provider.MinFee.HasValue)
                        {
                            <div class="h4 fw-bold mb-0">@provider.MinFee.Value.ToString("N0") <small class="fs-6 text-muted">EGP</small></div>
                        }
                        else
                        {
                            <div class="text-muted fst-italic">Price not available</div>
                        }
                    </div>

                    <h3 class="h6 fw-bold mb-3">Next available slots</h3>
                    @if (!slotDays.Any())
                    {
                        <div class="alert alert-light border">No upcoming slots are available.</div>
                    }
                    else
                    {
                        <div class="vstack gap-3 mb-4">
                            @foreach (var day in slotDays)
                            {
                                <div>
                                    <div class="small fw-semibold text-muted mb-2">@day.Key.ToString("dddd, d MMMM")</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var slot in day)
                                        {
                                            <span class="badge bg-light text-dark border">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <span class="d-block" tabindex="0" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Online booking opening soon">
                        <button class="btn btn-primary w-100 rounded-pill" type="button" disabled aria-disabled="true">
                            <i class="bi bi-calendar2-check me-1"></i> Book Appointment
                        </button>
                    </span>
                </div>
            </div>
        </aside>
    </div>
</div>
