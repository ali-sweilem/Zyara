@model ProviderProfileDto
@{
    ViewData["Title"] = "Settings";
}

<div class="container py-4" style="max-width:960px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1"><i class="bi bi-gear me-2 text-primary"></i>Settings</h1>
            <p class="text-muted mb-0">Manage your account preferences and security.</p>
        </div>
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="showprofile">
            <i class="bi bi-arrow-left me-1"></i>Back to Profile
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>
    }

    <div class="row g-4">
        @* ── Left: Navigation ── *@
        <div class="col-lg-3">
            <nav class="settings-nav nav flex-lg-column gap-1">
                <a class="nav-link active" href="#security-section">
                    <i class="bi bi-shield-lock me-2"></i>Security
                </a>
                <a class="nav-link" href="#availability-section">
                    <i class="bi bi-calendar-check me-2"></i>Availability
                </a>
                <a class="nav-link" href="#notifications-section">
                    <i class="bi bi-bell me-2"></i>Notifications
                </a>
                <a class="nav-link" href="#privacy-section">
                    <i class="bi bi-eye me-2"></i>Privacy
                </a>
                <a class="nav-link" href="#account-section">
                    <i class="bi bi-person-x me-2"></i>Account
                </a>
            </nav>
        </div>

        @* ── Right: Settings Panels ── *@
        <div class="col-lg-9">

            @* ── Security ── *@
            <section id="security-section" class="card border rounded-3 bg-white mb-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3"><i class="bi bi-shield-lock me-2 text-primary"></i>Security</h2>

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <div>
                            <div class="fw-semibold">Two-factor authentication</div>
                            <div class="text-muted small">Add an extra layer of security to your account.</div>
                        </div>
                        <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-controller="TwoFactor" asp-action="Manage">Manage</a>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <div>
                            <div class="fw-semibold">Verification</div>
                            <div class="text-muted small">View your verification status and documents.</div>
                        </div>
                        <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-controller="ProviderVerification" asp-action="Status">View</a>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3">
                        <div>
                            <div class="fw-semibold">Credentials</div>
                            <div class="text-muted small">Manage your professional credentials and certificates.</div>
                        </div>
                        <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-controller="ProviderCredentials" asp-action="Index">Manage</a>
                    </div>
                </div>
            </section>

            @* ── Availability ── *@
            <section id="availability-section" class="card border rounded-3 bg-white mb-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3"><i class="bi bi-calendar-check me-2 text-primary"></i>Availability</h2>

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <div class="fw-semibold small">Schedule</div>
                            <div class="text-muted" style="font-size:.8rem;">Manage your available time slots for patient bookings.</div>
                        </div>
                        <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-area="Provider" asp-controller="Schedule" asp-action="Index">Manage</a>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <div>
                            <div class="fw-semibold small">Services</div>
                            <div class="text-muted" style="font-size:.8rem;">Configure the services you offer and their pricing.</div>
                        </div>
                        <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-area="Provider" asp-controller="Services" asp-action="Index">Manage</a>
                    </div>
                </div>
            </section>

            @* ── Notifications ── *@
            <section id="notifications-section" class="card border rounded-3 bg-white mb-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3"><i class="bi bi-bell me-2 text-primary"></i>Notifications</h2>
                    <p class="text-muted small mb-3">Choose what you would like to be notified about.</p>

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <div class="fw-semibold small">New booking requests</div>
                            <div class="text-muted" style="font-size:.8rem;">Get notified when a patient submits a new booking request.</div>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" checked disabled>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <div class="fw-semibold small">Booking cancellations</div>
                            <div class="text-muted" style="font-size:.8rem;">Get notified when a patient cancels an upcoming appointment.</div>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" checked disabled>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <div class="fw-semibold small">New reviews</div>
                            <div class="text-muted" style="font-size:.8rem;">Get notified when a patient leaves a review on your profile.</div>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" checked disabled>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <div>
                            <div class="fw-semibold small">Wallet transactions</div>
                            <div class="text-muted" style="font-size:.8rem;">Get notified about payments and wallet activity.</div>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" checked disabled>
                        </div>
                    </div>
                    <p class="text-muted small mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>Notification preferences are coming soon.</p>
                </div>
            </section>

            @* ── Privacy ── *@
            <section id="privacy-section" class="card border rounded-3 bg-white mb-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3"><i class="bi bi-eye me-2 text-primary"></i>Privacy</h2>

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <div class="fw-semibold small">Profile visibility</div>
                            <div class="text-muted" style="font-size:.8rem;">Your public profile is visible to patients searching for providers.</div>
                        </div>
                        <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-2 py-1">Public</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <div>
                            <div class="fw-semibold small">Contact details</div>
                            <div class="text-muted" style="font-size:.8rem;">Phone and email are only shared with patients who have confirmed bookings.</div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill px-2 py-1">Protected</span>
                    </div>
                </div>
            </section>

            @* ── Account / Danger Zone ── *@
            <section id="account-section" class="card border rounded-3 bg-white">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3"><i class="bi bi-person-x me-2 text-danger"></i>Account</h2>
                    <p class="text-muted small mb-3">Permanent actions that cannot be undone.</p>
                    <div class="d-flex justify-content-between align-items-center py-2 border rounded-3 px-3" style="border-color: var(--zy-danger-bg) !important;">
                        <div>
                            <div class="fw-semibold small text-danger">Delete account</div>
                            <div class="text-muted" style="font-size:.8rem;">Permanently delete your account and all associated data.</div>
                        </div>
                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3" disabled>Delete</button>
                    </div>
                    <p class="text-muted small mt-2 mb-0"><i class="bi bi-info-circle me-1"></i>Account deletion will be available in a future update.</p>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.settings-nav .nav-link').forEach(link => {
            link.addEventListener('click', function () {
                document.querySelectorAll('.settings-nav .nav-link').forEach(l => l.classList.remove('active'));
                this.classList.add('active');
            });
        });
    </script>
}

