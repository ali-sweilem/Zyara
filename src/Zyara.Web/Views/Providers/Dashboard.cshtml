@model Zyara.Web.Models.ProviderDashboardViewModel

@{
    ViewData["Title"] = "Provider Dashboard";
}

<h1 class="mb-4">Provider Dashboard</h1>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card text-center p-3"><h6>Total Bookings</h6><h2>@Model.TotalBookings</h2></div></div>
    <div class="col-md-4"><div class="card text-center p-3"><h6>Pending Requests</h6><h2>@Model.PendingRequests</h2></div></div>
    <div class="col-md-4"><div class="card text-center p-3"><h6>Upcoming Bookings</h6><h2>@Model.UpcomingBookings</h2></div></div>
    <div class="col-md-4"><div class="card text-center p-3"><h6>Completed Bookings</h6><h2>@Model.CompletedBookings</h2></div></div>
    <div class="col-md-4"><div class="card text-center p-3"><h6>Total Earnings</h6><h2>@Model.TotalEarnings.ToString("N2")</h2></div></div>
</div>

<h4 class="mb-3">Pending Requests</h4>
@if (!Model.PendingList.Any())
{
    <p class="text-muted">No pending requests.</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table align-middle">
            <thead>
                <tr><th>Patient</th><th>Service</th><th>Date</th><th>Time</th><th>Price</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.PendingList)
                {
                    <tr>
                        <td>@r.PatientName</td>
                        <td>@r.ServiceName</td>
                        <td>@r.Date.ToString("yyyy-MM-dd")</td>
                        <td>@r.StartTime.ToString(@"hh\:mm")</td>
                        <td>@r.TotalPrice.ToString("N2")</td>
                        <td class="text-end">
                            <form asp-action="Accept" method="post" class="d-inline">
                                <input type="hidden" name="providerId" value="@Model.ProviderId" />
                                <input type="hidden" name="bookingId" value="@r.BookingId" />
                                <button type="submit" class="btn btn-success btn-sm">Accept</button>
                            </form>
                            <form asp-action="Reject" method="post" class="d-inline">
                                <input type="hidden" name="providerId" value="@Model.ProviderId" />
                                <input type="hidden" name="bookingId" value="@r.BookingId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h4 class="mb-3">Completed Visits</h4>
@if (!Model.CompletedList.Any())
{
    <p class="text-muted">No completed visits yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>Patient</th><th>Service</th><th>Date</th><th>Time</th><th>Price</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.CompletedList)
                {
                    <tr>
                        <td>@r.PatientName</td>
                        <td>@r.ServiceName</td>
                        <td>@r.Date.ToString("yyyy-MM-dd")</td>
                        <td>@r.StartTime.ToString(@"hh\:mm")</td>
                        <td>@r.TotalPrice.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}