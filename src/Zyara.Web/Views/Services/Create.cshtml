@model Zyara.Services.Features.Services.CreateServiceDto
@using Zyara.Domain.Enums

@{
    ViewData["Title"] = "Create Service";
}

<div class="mb-4 pb-3 border-bottom">
    <h3 class="fw-bold text-dark mb-1">Add New Service</h3>
    <p class="text-muted mb-0">
        Create a new healthcare service on Zyara.
    </p>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-md-5">

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger rounded-3">
            </div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-semibold">
                    Service Name
                </label>

                <input asp-for="Name"
                       class="form-control rounded-3 py-2"
                       placeholder="Enter service name" />

                <span asp-validation-for="Name"
                      class="text-danger small">
                </span>
            </div>

            <div class="mb-4">
                <label asp-for="Description"
                       class="form-label fw-semibold">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control rounded-3"
                          rows="4"
                          placeholder="Describe the healthcare service..."></textarea>

                <span asp-validation-for="Description"
                      class="text-danger small">
                </span>
            </div>

            <div class="mb-4">
                <label asp-for="Type" class="form-label fw-semibold">
                    Service Type
                </label>

                <select asp-for="Type"
                        asp-items="Html.GetEnumSelectList<ServiceType>()"
                        class="form-select rounded-3 py-2">
                    <option value="">-- Select Service Type --</option>
                </select>

                <span asp-validation-for="Type"
                      class="text-danger small">
                </span>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Index"
                   class="btn btn-light border rounded-pill px-4">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary rounded-pill px-4 fw-semibold">
                    <i class="bi bi-plus-lg me-1"></i>
                    Create Service
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
