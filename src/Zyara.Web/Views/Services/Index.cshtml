@model Zyara.Web.Models.ServiceIndexViewModel

@{
    ViewData["Title"] = "Manage Services";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom gap-3">
    <div>
        <h3 class="fw-bold text-dark mb-1">Manage Services</h3>
        <p class="text-muted mb-0">
            Manage healthcare services offered through Zyara.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary rounded-pill px-4 fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Add New Service
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        @if (Model.Services.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-clipboard2-x fs-1 text-muted"></i>
                <h5 class="fw-bold mt-3">No services found</h5>
                <p class="text-muted">
                    Start by adding your first healthcare service.
                </p>
                <a asp-action="Create"
                   class="btn btn-primary rounded-pill px-4">
                    Add Service
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Service Name</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var service in Model.Services)
                        {
                            <tr>
                                <td class="ps-4 text-muted">
                                    @service.Id
                                </td>

                                <td class="fw-semibold">
                                    @service.Name
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @service.Type
                                    </span>
                                </td>

                                <td class="text-muted"
                                    style="max-width: 250px;">
                                    @(string.IsNullOrWhiteSpace(service.Description)
                                        ? "No description"
                                        : service.Description)
                                </td>

                                <td>
                                    @if (service.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit"
                                           asp-route-id="@service.Id"
                                           class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="bi bi-pencil-square"></i>
                                            Edit
                                        </a>

                                        <form asp-action="ToggleStatus"
                                              asp-route-id="@service.Id"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="isActive"
                                                   value="@(!service.IsActive)" />

                                            <button type="submit"
                                                    class="btn btn-sm @(service.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-3">
                                                @if (service.IsActive)
                                                {
                                                    <i class="bi bi-pause-circle"></i>
                                                    <span>Deactivate</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check-circle"></i>
                                                    <span>Activate</span>
                                                }
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
