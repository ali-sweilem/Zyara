@model Zyara.Web.ViewModels.BookAppointmentViewModel

@{
    ViewData["Title"] = $"Book Appointment — {Model.ProviderFullName}";
}

<div class="container py-4 py-lg-5" style="max-width: 720px;">

    @* ── Back link ── *@
    <a asp-controller="Providers" asp-action="Details" asp-route-id="@Model.ProviderId"
       class="d-inline-flex align-items-center gap-1 text-muted text-decoration-none small mb-4">
        <i class="bi bi-arrow-left"></i> Back to provider profile
    </a>

    @* ── Provider summary card ── *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 d-flex align-items-center gap-4">
            @await Html.PartialAsync("_Avatar", new AvatarViewModel
            {
                FullName = Model.ProviderFullName,
                PhotoUrl = Model.ProviderPhotoUrl,
                Id = Model.ProviderId,
                Size = 72
            })
            <div>
                <h1 class="h4 fw-bold mb-1">@Model.ProviderFullName</h1>
                <p class="text-muted mb-0 small">
                    @(string.IsNullOrWhiteSpace(Model.ProviderSpecialty) ? "Healthcare Provider" : Model.ProviderSpecialty)
                    @if (!string.IsNullOrWhiteSpace(Model.ProviderBaseCity))
                    {
                        <span class="ms-2"><i class="bi bi-geo-alt text-danger"></i> @Model.ProviderBaseCity</span>
                    }
                </p>
            </div>
        </div>
    </div>

    @* ── Booking form card ── *@
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <h2 class="h5 fw-bold mb-4">
                <i class="bi bi-calendar2-check me-2 text-primary"></i>Book an Appointment
            </h2>

            @* ── Global validation summary ── *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <asp-validation-summary asp-validation-summary="All" class="mb-0 d-inline" />
                </div>
            }

            @if (!Model.AvailableSlots.Any())
            {
                <div class="alert alert-warning rounded-3" role="alert">
                    <i class="bi bi-calendar-x me-2"></i>
                    This provider has no available slots right now. Please check back later.
                </div>
                <a asp-controller="Providers" asp-action="Details" asp-route-id="@Model.ProviderId"
                   class="btn btn-outline-secondary rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            }
            else if (!Model.ProviderServices.Any())
            {
                <div class="alert alert-warning rounded-3" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    This provider has no active services listed. Booking is not possible at this time.
                </div>
                <a asp-controller="Providers" asp-action="Details" asp-route-id="@Model.ProviderId"
                   class="btn btn-outline-secondary rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            }
            else
            {
                <form asp-action="Book" asp-controller="Booking" method="post">
                    @Html.AntiForgeryToken()

                    @* ProviderId is a display field — read-only, re-submitted so the controller
                       can repopulate the VM on a failed POST, but its value is re-validated
                       server-side against the DB and never trusted for pricing. *@
                    <input type="hidden" asp-for="ProviderId" />

                    @* ── 1. Service selector ── *@
                    <div class="mb-4">
                        <label asp-for="SelectedProviderServiceId" class="form-label fw-semibold">
                            Select Service <span class="text-danger">*</span>
                        </label>
                        <select asp-for="SelectedProviderServiceId" class="form-select rounded-3">
                            <option value="">— choose a service —</option>
                            @foreach (var svc in Model.ProviderServices)
                            {
                                <option value="@svc.Id">@svc.Name — @svc.Fee.ToString("N0") EGP</option>
                            }
                        </select>
                        <span asp-validation-for="SelectedProviderServiceId" class="text-danger small"></span>
                    </div>

                    @* ── 2. Time slot selector ── *@
                    <div class="mb-4">
                        <label asp-for="SelectedTimeSlotId" class="form-label fw-semibold">
                            Select Time Slot <span class="text-danger">*</span>
                        </label>
                        <select asp-for="SelectedTimeSlotId" class="form-select rounded-3">
                            <option value="">— choose a slot —</option>
                            @foreach (var slot in Model.AvailableSlots)
                            {
                                <option value="@slot.Id">@slot.Label</option>
                            }
                        </select>
                        <span asp-validation-for="SelectedTimeSlotId" class="text-danger small"></span>
                    </div>

                    @* ── 3. Notes ── *@
                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold">
                            Notes <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <textarea asp-for="Notes" class="form-control rounded-3" rows="3"
                                  placeholder="Any additional information for the provider…"
                                  maxlength="500"></textarea>
                        <div class="form-text text-end">
                            <span id="notesCharCount">0</span> / 500
                        </div>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    @* ── Payment notice ── *@
                    <div class="alert alert-light border small d-flex align-items-start gap-2 mb-4" role="note">
                        <i class="bi bi-info-circle-fill text-primary mt-1 flex-shrink-0"></i>
                        <span>
                            Payment is <strong>cash on arrival</strong>. You will confirm payment details
                            on the next screen before the booking is finalised.
                        </span>
                    </div>

                    @* ── Actions ── *@
                    <div class="d-flex flex-wrap gap-3">
                        <button type="submit" class="btn btn-primary rounded-pill px-5">
                            <i class="bi bi-calendar2-check me-1"></i> Confirm Booking
                        </button>
                        <a asp-controller="Providers" asp-action="Details" asp-route-id="@Model.ProviderId"
                           class="btn btn-outline-secondary rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        // Live character counter for the Notes textarea
        (function () {
            const textarea = document.getElementById('Notes');
            const counter = document.getElementById('notesCharCount');
            if (!textarea || !counter) return;

            function update() {
                counter.textContent = textarea.value.length;
            }

            textarea.addEventListener('input', update);
            update(); // initialise on page load (handles repopulated form on failed POST)
        }());
    </script>
}

