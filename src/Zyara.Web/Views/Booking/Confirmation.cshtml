@model Zyara.Services.Features.Payments.Dtos.BookingConfirmationDto

@{
    ViewData["Title"] = "Booking Confirmation";
}

<div class="container py-5" style="max-width: 600px;">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 text-center p-4">
        <div class="card-body">
            <div class="mb-3 text-success">
                <i class="bi bi-check-circle-fill" style="font-size: 3.5rem;"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Request Submitted!</h3>
            <p class="text-muted mb-4">
                Your booking request is now <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-2 fs-6">@Model.Status</span>
            </p>

            <div class="bg-light rounded-3 p-3 text-start mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Booking ID:</span>
                    <strong class="text-dark">#@Model.BookingId</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Total Price:</span>
                    <strong class="text-dark">@Model.TotalPrice.ToString("N2") EGP</strong>
                </div>
            </div>

            @if (Model.IsHomeVisit && !string.IsNullOrEmpty(Model.OtpCode))
            {
                <div class="border border-2 border-primary border-opacity-25 bg-primary bg-opacity-10 rounded-4 p-4 my-4">
                    <h5 class="text-primary fw-bold mb-1">Your Arrival Verification OTP</h5>
                    <p class="text-muted small mb-2">Share this code with your provider upon physical arrival at your door:</p>
                    <div class="display-5 fw-bold text-dark letter-spacing my-2">@Model.OtpCode</div>
                </div>
            }

            <div class="d-flex justify-content-center gap-3 mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                    Return to Home
                </a>
            </div>
        </div>
    </div>
</div>