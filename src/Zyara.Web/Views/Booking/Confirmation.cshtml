@model Zyara.Services.Features.Payments.Dtos.BookingConfirmationDto

@{
    ViewData["Title"] = "Booking Request Submitted";
}

<div class="container py-4 py-lg-5" style="max-width: 620px;">
    @if (TempData["Success"] != null || TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @(TempData["Success"] ?? TempData["Message"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5">
        <div class="mb-3 text-success">
            <i class="bi bi-check-circle-fill" style="font-size: 3.8rem;"></i>
        </div>

        <h1 class="h3 fw-bold text-dark mb-1">Request Sent!</h1>
        <p class="text-muted mb-4">
            Waiting for provider clinical acceptance
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 ms-1">
                @Model.Status
            </span>
        </p>

        <!-- Summary Box -->
        <div class="bg-light rounded-4 p-4 text-start mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                <span class="text-muted small">Booking ID:</span>
                <strong class="text-dark">#@Model.BookingId</strong>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                <span class="text-muted small">Healthcare Provider:</span>
                <strong class="text-dark">@Model.ProviderFullName</strong>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                <span class="text-muted small">Medical Service:</span>
                <strong class="text-dark">@Model.ServiceName</strong>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                <span class="text-muted small">2-Hour Arrival Window:</span>
                <strong class="text-primary">@Model.DayLabel, @Model.FormattedWindow</strong>
            </div>

            @if (Model.IsHomeVisit && !string.IsNullOrWhiteSpace(Model.VisitAddress))
            {
                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                    <span class="text-muted small">Visit Address:</span>
                    <span class="text-dark text-end small">@Model.VisitAddress</span>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center pt-1">
                <span class="text-muted small">Payment Details:</span>
                <div class="text-end">
                    <span class="badge @(Model.PaymentMethod == PaymentMethod.CashOnArrival ? "bg-light text-dark border" : "bg-primary-subtle text-primary border") rounded-pill mb-1">
                        @Model.PaymentMethod
                    </span>
                    <div class="small fw-semibold text-dark">
                        @if (Model.PaymentMethod == PaymentMethod.CashOnArrival)
                        {
                            <span>Pay @Model.TotalPrice.ToString("N0") EGP in cash after the visit</span>
                        }
                        else
                        {
                            <span>Hold of @Model.TotalPrice.ToString("N0") EGP placed — charged after the visit</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- OTP Code Box for Home Visits -->
        @if (Model.IsHomeVisit && !string.IsNullOrEmpty(Model.OtpCode))
        {
            <div class="border border-2 border-primary border-opacity-25 bg-primary bg-opacity-10 rounded-4 p-4 mb-4">
                <h2 class="h6 text-primary fw-bold mb-1">
                    <i class="bi bi-shield-check me-1"></i> Your Arrival Verification OTP
                </h2>
                <p class="text-muted small mb-3">
                    Keep this 4-digit code confidential until your provider physically arrives at your door.
                </p>
                <div class="display-5 fw-bold text-dark letter-spacing-lg mb-2">
                    @Model.OtpCode
                </div>
                <small class="text-muted">Give this code to the healthcare provider to initiate the medical visit.</small>
            </div>
        }

        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-house-door me-1"></i> Return to Home
            </a>
        </div>
    </div>
</div>
