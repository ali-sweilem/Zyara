<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zyara.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Zyara.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isLanding = string.Equals(currentController, "Landing", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
        var isPrivacy = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Privacy", StringComparison.OrdinalIgnoreCase);
        var isProfile = string.Equals(currentController, "Providers", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "showprofile", StringComparison.OrdinalIgnoreCase);
        var isAdmin = User.IsInRole("Admin");
        var isProvider = User.IsInRole("Doctor") || User.IsInRole("Nurse");
        var isPatient = User.IsInRole("Patient");
        var currentArea = ViewContext.RouteData.Values["area"]?.ToString();

        bool IsActive(string controller, string? area = null) =>
            string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(currentArea ?? "", area ?? "", StringComparison.OrdinalIgnoreCase);

        string Active(string controller, string? area = null) => IsActive(controller, area) ? "is-active" : "";
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow sticky-top site-navbar">
            <div class="container">
                @if (isAdmin)
                {
                    <a class="navbar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" aria-label="Zyara">
                        <img class="d-none d-sm-block" src="~/images/branding/zyara-logo.svg" width="145" height="40" alt="Zyara" />
                        <img class="d-sm-none" src="~/images/branding/zyara-icon.svg" width="36" height="36" alt="Zyara" />
                    </a>
                }
                else if (isProvider)
                {
                    <a class="navbar-brand" asp-area="Provider" asp-controller="Dashboard" asp-action="Index" aria-label="Zyara">
                        <img class="d-none d-sm-block" src="~/images/branding/zyara-logo.svg" width="145" height="40" alt="Zyara" />
                        <img class="d-sm-none" src="~/images/branding/zyara-icon.svg" width="36" height="36" alt="Zyara" />
                    </a>
                }
                else
                {
                <a class="navbar-brand" asp-area="" asp-controller="Landing" asp-action="Index" aria-label="Zyara">
                    <img class="d-none d-sm-block" src="~/images/branding/zyara-logo.svg" width="145" height="40" alt="Zyara" />
                    <img class="d-sm-none" src="~/images/branding/zyara-icon.svg" width="36" height="36" alt="Zyara" />
                </a>
                }
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Open navigation menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between" id="navbarSupportedContent">
                    <ul class="navbar-nav flex-grow-1 align-items-lg-center">
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Dashboard", "Admin")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("AdminUsers", "Admin")" asp-area="Admin" asp-controller="AdminUsers" asp-action="Index">Users</a></li>
                            <li class="nav-item"><a class="nav-link @Active("AdminProviders", "Admin")" asp-area="Admin" asp-controller="AdminProviders" asp-action="Index">Providers</a></li>
                            <li class="nav-item"><a class="nav-link @Active("AdminBookings", "Admin")" asp-area="Admin" asp-controller="AdminBookings" asp-action="Index">Bookings</a></li>
                            <li class="nav-item"><a class="nav-link @Active("AdminServices", "Admin")" asp-area="Admin" asp-controller="AdminServices" asp-action="Index">Services</a></li>
                            <li class="nav-item"><a class="nav-link @Active("AdminFees", "Admin")" asp-area="Admin" asp-controller="AdminFees" asp-action="Index">Fees</a></li>
                        }
                        else if (isProvider)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Dashboard", "Provider")" asp-area="Provider" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Bookings", "Provider")" asp-area="Provider" asp-controller="Bookings" asp-action="Index">Bookings</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Schedule", "Provider")" asp-area="Provider" asp-controller="Schedule" asp-action="Index">Schedule</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Services", "Provider")" asp-area="Provider" asp-controller="Services" asp-action="Index">My services</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Wallet", "Provider")" asp-area="Provider" asp-controller="Wallet" asp-action="Index">Wallet</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Providers")" asp-area="" asp-controller="Providers" asp-action="showprofile">Profile</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @(isLanding ? "is-active" : "")" asp-area="" asp-controller="Landing" asp-action="Index" aria-current="@(isLanding ? "page" : null)">Services</a></li>
                            @if (isPatient)
                            {
                                <li class="nav-item"><a class="nav-link @Active("Patient")" asp-area="" asp-controller="Patient" asp-action="Index">Dashboard</a></li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Zyara - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


