@model Zyara.Services.Features.Identity.Dtos.TwoFactorSetupDto
@{
    ViewData["Title"] = "Set up two-factor authentication";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="card-title mb-2">Set up two-factor authentication</h3>
                <p class="text-muted">
                    Scan this QR code with Google Authenticator, Microsoft Authenticator, or any TOTP app.
                </p>

                <div class="text-center mb-4">
                    <img src="@Model.QrCodeImage" alt="QR code for the Zyara authenticator key"
                         width="220" height="220" class="img-fluid border rounded p-2 bg-white" />
                </div>

                <p class="mb-1">Can't scan the code? Enter this key in the app manually:</p>
                <p><code class="fs-5">@Model.SharedKey</code></p>

                <hr />

                <form asp-controller="TwoFactor" asp-action="Enable" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label for="code" class="form-label">Enter the 6-digit code shown in the app</label>
                        <input id="code" name="Code" class="form-control form-control-lg"
                               inputmode="numeric" autocomplete="one-time-code" maxlength="7" required />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Verify and enable</button>
                        <a asp-controller="TwoFactor" asp-action="Manage" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
