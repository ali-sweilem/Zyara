@model Zyara.Services.Features.Identity.Dtos.TwoFactorSetupDto
@{
    ViewData["Title"] = "Set up two-factor authentication";
}

<section class="py-4 py-md-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width: 560px;">
        <div class="card-body p-4 p-md-5">
            <h1 class="h3 fw-bold mb-3">Set up an authenticator app</h1>

            <ol class="text-muted ps-3 mb-4">
                <li>Install Google Authenticator or Microsoft Authenticator on your phone.</li>
                <li>Scan this QR code (or type the key below).</li>
                <li>Enter the 6-digit code the app shows.</li>
            </ol>

            <div class="text-center mb-3">
                <img src="data:image/png;base64,@Model.QrCodeBase64" alt="QR code" width="200" height="200" />
            </div>
            <p class="text-center small text-muted mb-4">Can't scan? Enter this key manually:<br /><code class="fs-6">@Model.SharedKey</code></p>

            <form asp-action="Setup" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4"></div>
                <input type="hidden" asp-for="SharedKey" />
                <input type="hidden" asp-for="QrCodeBase64" />

                <div class="mb-4">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control form-control-lg text-center" inputmode="numeric" autocomplete="one-time-code" maxlength="10" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill">Turn on two-factor</button>
                    <a asp-action="Manage" class="btn btn-link">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
