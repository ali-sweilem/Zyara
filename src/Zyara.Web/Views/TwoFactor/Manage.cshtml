@model Zyara.Services.Features.Identity.Dtos.TwoFactorStatusDto
@{
    ViewData["Title"] = "Two-factor authentication";
}

<section class="py-4 py-md-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width: 520px;">
        <div class="card-body p-4 p-md-5">
            <h1 class="h3 fw-bold mb-3">Two-factor authentication</h1>

            @if (TempData["Message"] is string ok) { <div class="alert alert-success border-0 rounded-4">@ok</div> }
            @if (TempData["Error"] is string err) { <div class="alert alert-danger border-0 rounded-4">@err</div> }

            @if (Model.IsEnabled)
            {
                <p><span class="badge bg-success">On</span> You are asked for a code from your authenticator app when you sign in.</p>
                <p class="text-muted small">Unused recovery codes: <strong>@Model.RecoveryCodesLeft</strong></p>

                <form asp-action="Disable" method="post" class="mt-4">
                    @if (Model.HasPassword)
                    {
                        <div class="mb-3">
                            <label for="Password" class="form-label">Confirm your password to turn it off</label>
                            <input id="Password" name="Password" type="password" class="form-control" autocomplete="current-password" />
                        </div>
                    }
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4">Turn off two-factor</button>
                </form>
            }
            else
            {
                <p><span class="badge bg-secondary">Off</span> Add a second step to protect your account with an authenticator app.</p>
                <a asp-action="Setup" class="btn btn-primary rounded-pill px-4">Set up authenticator app</a>
            }
        </div>
    </div>
</section>
