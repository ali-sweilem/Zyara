@model Zyara.Services.Features.Identity.Dtos.RecoveryCodesDto
@{
    ViewData["Title"] = "Recovery codes";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="card-title mb-2">Save your recovery codes</h3>
                <p class="text-muted">
                    Two-factor authentication is now on. If you lose your phone, each of these codes lets you
                    sign in <strong>once</strong>. Store them somewhere safe (password manager or printed copy).
                </p>

                <div class="alert alert-warning mb-3">
                    This is the only time these codes are shown. They cannot be displayed again.
                </div>

                <div class="border rounded bg-light p-3 mb-4">
                    <div class="row row-cols-2 g-2">
                        @foreach (var code in Model.Codes)
                        {
                            <div class="col"><code class="fs-6">@code</code></div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-controller="TwoFactor" asp-action="Manage" class="btn btn-primary">I saved my codes</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go to home</a>
                </div>
            </div>
        </div>
    </div>
</div>
