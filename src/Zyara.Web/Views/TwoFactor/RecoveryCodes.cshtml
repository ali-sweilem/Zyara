@model Zyara.Services.Features.Identity.Dtos.RecoveryCodesDto
@{
    ViewData["Title"] = "Recovery codes";
}

<section class="py-4 py-md-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width: 520px;">
        <div class="card-body p-4 p-md-5">
            <div class="alert alert-success border-0 rounded-4">Two-factor authentication is on.</div>
            <h1 class="h4 fw-bold mb-2">Save your recovery codes</h1>
            <p class="text-muted">If you lose your phone, each of these codes lets you sign in once. They are shown <strong>only now</strong>. Store them somewhere safe.</p>

            <div class="row g-2 mb-4">
                @foreach (var code in Model.Codes)
                {
                    <div class="col-6"><code class="d-block text-center bg-light rounded-3 py-2">@code</code></div>
                }
            </div>

            <div class="d-grid">
                <a asp-action="Manage" class="btn btn-primary rounded-pill">I saved them</a>
            </div>
        </div>
    </div>
</section>
