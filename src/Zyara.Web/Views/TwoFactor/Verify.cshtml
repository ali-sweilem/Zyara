@model Zyara.Services.Features.Identity.Dtos.TwoFactorVerifyDto
@{
    ViewData["Title"] = "Two-factor verification";
}

<section class="py-4 py-md-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width: 460px;">
        <div class="card-body p-4 p-md-5">
            <h1 class="h3 fw-bold mb-1">Two-factor verification</h1>
            <p class="text-muted mb-4">Open your authenticator app and enter the 6-digit code for Zyara.</p>

            <form asp-action="Verify" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4"></div>
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="RememberMe" />

                <div class="mb-3">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control form-control-lg text-center" inputmode="numeric" autocomplete="one-time-code" maxlength="10" autofocus />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMachine" class="form-check-input" />
                    <label asp-for="RememberMachine" class="form-check-label"></label>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill">Verify</button>
                </div>
            </form>

            <div class="text-center mt-4 small">
                <a asp-action="UseRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Lost your phone? Use a recovery code</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
