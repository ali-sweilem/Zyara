@model Zyara.Services.Features.Identity.Dtos.TwoFactorVerifyDto
@{
    ViewData["Title"] = "Two-factor authentication";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-2">Two-factor authentication</h3>
                <p class="text-muted text-center mb-4">
                    Open your authenticator app and enter the 6-digit code for Zyara.
                </p>

                <form asp-controller="TwoFactor" asp-action="Verify" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label"></label>
                        <input asp-for="Code" class="form-control form-control-lg text-center"
                               inputmode="numeric" autocomplete="one-time-code" autofocus maxlength="7" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Verify</button>
                    </div>
                </form>

                <p class="text-center text-muted mt-4 mb-0">
                    Lost your phone?
                    <a asp-action="UseRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">Use a recovery code</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
