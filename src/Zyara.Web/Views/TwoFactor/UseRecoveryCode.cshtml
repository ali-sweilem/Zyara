@model Zyara.Services.Features.Identity.Dtos.RecoveryCodeLoginDto
@{
    ViewData["Title"] = "Use a recovery code";
}

<section class="py-4 py-md-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width: 460px;">
        <div class="card-body p-4 p-md-5">
            <h1 class="h3 fw-bold mb-1">Recovery code</h1>
            <p class="text-muted mb-4">Enter one of the recovery codes you saved. Each code works only once.</p>

            <form asp-action="UseRecoveryCode" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-4">
                    <label asp-for="RecoveryCode" class="form-label"></label>
                    <input asp-for="RecoveryCode" class="form-control form-control-lg text-center" autocomplete="off" autofocus />
                    <span asp-validation-for="RecoveryCode" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill">Sign in</button>
                </div>
            </form>

            <div class="text-center mt-4 small">
                <a asp-action="Verify" asp-route-returnUrl="@Model.ReturnUrl">Back to authenticator code</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
