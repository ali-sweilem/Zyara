@model Zyara.Web.Models.ServiceOption

<div class="card-body d-flex flex-column align-items-center text-center p-4 p-lg-5">
    <span class="service-card-icon mb-4" aria-hidden="true">
        <i class="bi @Model.Icon"></i>
    </span>
    <h2 class="h4 fw-bold text-dark mb-2">@Model.Label</h2>
    <p class="text-muted mb-0">@Model.Description</p>
    @if (Model.ComingSoon)
    {
        <span class="badge rounded-pill text-bg-secondary mt-4">Coming soon</span>
    }
</div>
