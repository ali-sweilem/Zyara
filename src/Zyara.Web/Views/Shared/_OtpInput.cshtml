@model string
<div class="otp-row" role="group" aria-label="4-digit verification code" aria-describedby="otp-help">
  <input class="otp-box" type="text" inputmode="numeric" maxlength="1" aria-label="Digit 1" data-otp-index="1" />
  <input class="otp-box" type="text" inputmode="numeric" maxlength="1" aria-label="Digit 2" data-otp-index="2" />
  <input class="otp-box" type="text" inputmode="numeric" maxlength="1" aria-label="Digit 3" data-otp-index="3" />
  <input class="otp-box" type="text" inputmode="numeric" maxlength="1" aria-label="Digit 4" data-otp-index="4" />
</div>
<p id="otp-help" class="sr-only">Enter 4-digit code. Auto-advance on type; backspace to go back; paste full code supported.</p>
