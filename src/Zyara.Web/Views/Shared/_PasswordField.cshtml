@model string
<div class="auth-field input-password">
  <label for="@ViewData["ForName"]">@ViewData["Label"]</label>
  <div class="input-with-icon input-password">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    <input id="@ViewData["ForName"]" name="@ViewData["Name"]" value="@Model" class="auth-input" type="password" aria-required="true" />
    <button type="button" data-toggle-password="@ViewData["ForName"]" aria-label="Show or hide password" class="btn-password"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
  </div>
</div>
