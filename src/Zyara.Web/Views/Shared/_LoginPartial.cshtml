@using Microsoft.AspNetCore.Identity
@using Zyara.Domain.Entities
@using Zyara.Domain.Enums
@using Zyara.Services.Features.Identity.Interfaces
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject ICurrentUser CurrentUser

@*
    Navbar account area.
    Guest  -> Sign In (primary pill) & Register (outline pill)
    Signed -> name + Security + Logout (POST form)
    Admin  -> extra Admin badge/button
*@
@if (SignInManager.IsSignedIn(User))
{
    var account = await UserManager.GetUserAsync(User);
    var displayName = account?.FullName ?? User.Identity?.Name ?? "My Account";

    <div class="d-flex align-items-center gap-2">
        @if (CurrentUser.Role == UserRole.Admin)
        {
            <a class="btn btn-sm btn-outline-primary rounded-pill px-3" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2 me-1"></i> Admin
            </a>
        }

        <a class="nav-link text-dark px-2 small fw-medium" asp-controller="TwoFactor" asp-action="Manage" title="Account Security & 2FA">
            <i class="bi bi-shield-lock me-1 text-muted"></i> Security
        </a>

        <span class="navbar-text text-dark fw-semibold px-2 small">
            <i class="bi bi-person-circle me-1 text-primary"></i> @displayName
        </span>

        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-box-arrow-right me-1"></i> Logout
            </button>
        </form>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-medium" asp-controller="Register" asp-action="Index">
            Register
        </a>
        <a class="btn btn-sm btn-primary rounded-pill px-3 fw-medium shadow-sm" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
        </a>
    </div>
}
