@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}
<ul class="navbar-nav align-items-lg-center">
    @if (isSignedIn)
    {
        <li class="nav-item"><partial name="_NotificationBell" /></li>
        <li class="nav-item">
            <span class="navbar-text me-lg-2">@(User.Identity!.Name)</span>
        </li>
        <li class="nav-item">
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Logout</button>
            </form>
            <partial name="_SessionKeepAlive" />
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary btn-sm rounded-pill px-3" asp-area="" asp-controller="Register" asp-action="Index">Register</a>
        </li>
    }
</ul>
