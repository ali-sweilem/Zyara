<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - Zyara</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet" href="~/css/auth-tokens.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/auth-layout.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/Zyara.Web.styles.css" asp-append-version="true" />
</head>
<body>
<header>
<nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm">
<div class="container-fluid">
<a class="navbar-brand fw-bold text-teal" asp-area="" asp-controller="Home" asp-action="Index"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-3H17"/></svg> Zyara Health</a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"><span class="navbar-toggler-icon"></span></button>
<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
<ul class="navbar-nav flex-grow-1">
<li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
<li class="nav-item"><a class="nav-link fw-semibold" asp-area="Provider" asp-controller="Dashboard" asp-action="Index"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-3H17"/></svg> Provider Portal (Doctor & Nurse)</a></li>
<li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
</ul>
<ul class="navbar-nav ms-auto align-items-center">
@if (User.Identity.IsAuthenticated) {
<li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity.Name</a><ul class="dropdown-menu dropdown-menu-end shadow-sm border-0"><li><form asp-controller="Account" asp-action="Logout" method="post"><input type="hidden" name="__RequestVerificationToken" value="@Html.AntiForgeryToken()"/><button type="submit" class="dropdown-item">Logout</button></form></li></ul></li>
} else {
<li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
<li class="nav-item"><a class="nav-link btn btn-sm btn-primary rounded-pill px-3" asp-controller="Account" asp-action="Register">Register</a></li>
}
</ul>
</div>
</div>
</nav>
</header>
<div class="auth-page">
  <main class="auth-form-center" role="main">
    @RenderBody()
  </main>
</div>
<footer class="border-top footer text-muted"><div class="container">&copy; 2026 - Zyara.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></div></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
