@model Zyara.Services.Features.Identity.Dtos.ResendConfirmationDto
@{
    ViewData["Title"] = "Resend confirmation email";
}

<section class="py-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width: 520px;">
        <div class="card-body p-4 p-md-5">
            <h1 class="h3 fw-bold mb-1">Resend confirmation email</h1>
            <p class="text-muted mb-4">Enter the email you registered with and we&apos;ll send a new link.</p>

            <form asp-action="Resend" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary rounded-pill py-2">Send link</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
