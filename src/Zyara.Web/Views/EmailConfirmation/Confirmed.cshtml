@model bool
@{
    ViewData["Title"] = Model ? "Email confirmed" : "Link not valid";
}

<section class="py-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto text-center" style="max-width: 560px;">
        <div class="card-body p-4 p-md-5">
            @if (Model)
            {
                <i class="bi bi-check-circle display-4 text-success mb-3"></i>
                <h1 class="h3 fw-bold mb-2">Email confirmed</h1>
                <p class="text-muted">Your account is active. You can sign in now.</p>
                <a href="/Account/Login" class="btn btn-primary rounded-pill px-4 mt-2">Sign in</a>
            }
            else
            {
                <i class="bi bi-x-circle display-4 text-danger mb-3"></i>
                <h1 class="h3 fw-bold mb-2">This link is not valid</h1>
                <p class="text-muted">The link may have expired, or it was already used. Request a new one.</p>
                <a asp-action="Resend" class="btn btn-primary rounded-pill px-4 mt-2">Send a new link</a>
            }
        </div>
    </div>
</section>
