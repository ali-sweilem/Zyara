@{
    ViewData["Title"] = "Check your email";
}

<section class="py-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto text-center" style="max-width: 560px;">
        <div class="card-body p-4 p-md-5">
            <i class="bi bi-envelope-check display-4 text-primary mb-3"></i>
            <h1 class="h3 fw-bold mb-2">Check your email</h1>

            @if (TempData["ResendInfo"] is string info)
            {
                <div class="alert alert-info border-0 rounded-4">@info</div>
            }
            else
            {
                <p class="text-muted">
                    We sent you a confirmation link. Open it to activate your account, then sign in.
                    The link expires in 30 minutes.
                </p>
            }

            @if (TempData["DevConfirmLink"] is string devLink)
            {
                <div class="alert alert-warning border-0 rounded-4 mt-4 mb-0">
                    <div class="small fw-semibold mb-2">DEVELOPMENT ONLY</div>
                    <a href="@devLink" class="btn btn-warning rounded-pill px-4">Confirm my email now</a>
                </div>
            }

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center mt-4">
                <a href="/Account/Login" class="btn btn-primary rounded-pill px-4">Go to sign in</a>
                <a asp-action="Resend" class="btn btn-outline-primary rounded-pill px-4">Resend the link</a>
            </div>
        </div>
    </div>
</section>
