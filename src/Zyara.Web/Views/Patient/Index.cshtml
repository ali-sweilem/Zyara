@model Zyara.Services.Features.Patients.Dtos.PatientDashboardDto
@using Zyara.Domain.Enums
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-primary fw-semibold mb-1">Patient Portal</p>
            <h1 class="h3 mb-1">Welcome, @Model.PatientName</h1>
            <p class="text-muted mb-0">Manage your visits and saved addresses.</p>
        </div>
        <a class="btn btn-primary rounded-pill px-4" asp-controller="Home" asp-action="Index">Find a provider</a>
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

    <div class="row g-4">
        <div class="col-lg-8">
            <section class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="h5 mb-3">My bookings</h2>
                    @if (Model.Bookings.Count == 0)
                    {
                        <p class="text-muted mb-0">You do not have any bookings yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead><tr><th>Service</th><th>Provider</th><th>Date</th><th>Status</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var booking in Model.Bookings)
                                {
                                    <tr>
                                        <td>@booking.ServiceName</td>
                                        <td>@booking.ProviderName</td>
                                        <td>@booking.Date @booking.StartTime</td>
                                        <td><span class="badge text-bg-light">@booking.Status</span></td>
                                        <td class="text-end">
                                            @if (booking.CanCancel)
                                            {
                                                <form asp-action="Cancel" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bookingId" value="@booking.Id" />
                                                    <button class="btn btn-sm btn-outline-danger rounded-pill" type="submit">Cancel</button>
                                                </form>
                                            }
                                            @if (booking.CanReview)
                                            {
                                                <a class="btn btn-sm btn-primary rounded-pill mt-2" asp-controller="Reviews" asp-action="Create" asp-route-bookingId="@booking.Id">Rate visit</a>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>
        </div>
        <div class="col-lg-4">
            <section class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="h5 mb-3">Saved addresses</h2>
                    @if (Model.Addresses.Count == 0) { <p class="text-muted mb-0">No saved addresses yet.</p> }
                    else { <ul class="list-group list-group-flush">@foreach (var address in Model.Addresses) { <li class="list-group-item px-0"><strong>@address.Label</strong><br /><span class="text-muted small">@address.FullAddress</span></li> }</ul> }
                </div>
            </section>
        </div>
    </div>
</div>
