@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 text-center p-4">
            <div class="card-body">
                <div class="mb-3">
                    <i class="bi bi-envelope-check text-primary" style="font-size: 3.5rem;"></i>
                </div>
                <h3 class="card-title mb-3">Check Your Email</h3>
                <p class="text-muted mb-4">
                    If an account exists with the email you entered, we have sent instructions and a link to reset your password.
                    Please check your inbox (and spam/junk folder).
                </p>
                <div class="alert alert-info py-2" role="alert">
                    <small>The reset link is valid for 30 minutes and can only be used once.</small>
                </div>
                <div class="mt-4">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Return to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

