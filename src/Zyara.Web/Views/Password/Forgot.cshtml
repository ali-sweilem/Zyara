@model Zyara.Services.Features.Identity.Dtos.ForgotPasswordDto
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-3">Forgot Password</h3>
                <p class="text-muted text-center mb-4">Enter your email address and we will send you a link to reset your password.</p>

                <form asp-action="Forgot" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">Send Reset Link</button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

