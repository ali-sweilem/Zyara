@model Zyara.Web.Models.ContactInquiryViewModel
@{
    ViewData["Title"] = "Contact Us - Customer Care & Support";
    var successMsg = TempData["SuccessMessage"] as string;
}

<!-- Emergency Medical Notice -->
<div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-3 p-3">
    <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
    </div>
    <div class="flex-grow-1">
        <h6 class="fw-bold mb-1 text-danger">Medical Emergency Warning</h6>
        <p class="mb-0 small text-danger-emphasis">
            If you or a family member are experiencing an acute, life-threatening emergency, please call <strong>123 (Egyptian Ambulance Authority)</strong> immediately. Zyara provides scheduled home medical visits and consultations.
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(successMsg))
{
    <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-3 p-3 animate__animated animate__fadeIn">
        <i class="bi bi-check-circle-fill text-success fs-3 flex-shrink-0"></i>
        <div>
            <h6 class="fw-bold mb-0 text-success">Message Sent Successfully!</h6>
            <p class="mb-0 small text-success-emphasis">@successMsg</p>
        </div>
    </div>
}

<!-- Hero Section -->
<div class="text-center py-4 mb-4">
    <span class="badge rounded-pill bg-primary-subtle text-primary fw-semibold px-3 py-2 mb-2">
        <i class="bi bi-headset me-1"></i> 24/7 Patient & Provider Support
    </span>
    <h1 class="fw-bold text-dark mb-2">We Are Here To Help</h1>
    <p class="text-muted fs-6 mx-auto" style="max-width: 650px;">
        Have questions about booking a doctor or nurse at home? Need help with an ongoing visit or want to partner with our medical network? Reach out to our specialized care team anytime.
    </p>
</div>

<!-- 4 Quick Action Cards (Vezeeta Style) -->
<div class="row g-3 mb-5">
    <!-- Hotline -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-3 hover-elevate transition">
            <div class="rounded-circle bg-primary-subtle text-primary mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                <i class="bi bi-telephone-fill fs-4"></i>
            </div>
            <h6 class="fw-bold mb-1">Customer Hotline</h6>
            <div class="fs-4 fw-bolder text-primary mb-1">16543</div>
            <p class="text-muted small mb-3">Daily from 08:00 AM – 12:00 AM</p>
            <a href="tel:16543" class="btn btn-outline-primary btn-sm rounded-pill w-100 mt-auto fw-semibold">
                <i class="bi bi-telephone-outbound me-1"></i> Call Now
            </a>
        </div>
    </div>

    <!-- WhatsApp Medical Care -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-3 hover-elevate transition">
            <div class="rounded-circle bg-success-subtle text-success mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                <i class="bi bi-whatsapp fs-4"></i>
            </div>
            <h6 class="fw-bold mb-1">WhatsApp Care</h6>
            <div class="fs-5 fw-bold text-success mb-1">+20 100 000 9999</div>
            <p class="text-muted small mb-3">Instant booking assistance & chat</p>
            <a href="https://wa.me/201000009999" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success btn-sm rounded-pill w-100 mt-auto fw-semibold">
                <i class="bi bi-chat-dots me-1"></i> Chat on WhatsApp
            </a>
        </div>
    </div>

    <!-- Email Support -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-3 hover-elevate transition">
            <div class="rounded-circle bg-info-subtle text-info mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                <i class="bi bi-envelope-fill fs-4"></i>
            </div>
            <h6 class="fw-bold mb-1">Email Inquiries</h6>
            <div class="fw-bold text-dark mb-1">care@zyara.com</div>
            <p class="text-muted small mb-3">Responses within 2 business hours</p>
            <a href="mailto:care@zyara.com" class="btn btn-outline-info btn-sm rounded-pill w-100 mt-auto fw-semibold">
                <i class="bi bi-send me-1"></i> Send Email
            </a>
        </div>
    </div>

    <!-- Headquarters -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-3 hover-elevate transition">
            <div class="rounded-circle bg-warning-subtle text-warning-emphasis mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                <i class="bi bi-geo-alt-fill fs-4"></i>
            </div>
            <h6 class="fw-bold mb-1">Main Headquarters</h6>
            <div class="fw-semibold text-dark small mb-1">New Cairo, Egypt</div>
            <p class="text-muted small mb-3">Bldg 42, North 90th St, 5th Settlement</p>
            <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm rounded-pill w-100 mt-auto fw-semibold">
                <i class="bi bi-map me-1"></i> View on Map
            </a>
        </div>
    </div>
</div>

<!-- Main Section: Form & Info -->
<div class="row g-4 mb-5">
    <!-- Contact Form -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 h-100">
            <h4 class="fw-bold mb-2">Send Us a Message</h4>
            <p class="text-muted small mb-4">
                Fill out the form below and our medical team will reach back out to you promptly.
            </p>

            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label small fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Dr. / Mr. Ahmed Hassan" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label small fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. 01012345678" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="InquiryType" class="form-label small fw-semibold"></label>
                        <select asp-for="InquiryType" class="form-select">
                            <option value="">-- Choose Category --</option>
                            <option value="Patient Support">Patient Support & Booking Help</option>
                            <option value="Provider Partnership">Doctor / Nurse Join Network</option>
                            <option value="Billing & Payments">Billing, Refunds & Payments</option>
                            <option value="Corporate Healthcare">Corporate & Insurance Coverage</option>
                            <option value="Feedback">Feedback & Suggestions</option>
                            <option value="Complaint">File a Complaint</option>
                        </select>
                        <span asp-validation-for="InquiryType" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label small fw-semibold"></label>
                    <input asp-for="Subject" class="form-control" placeholder="Brief subject of your inquiry" />
                    <span asp-validation-for="Subject" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Message" class="form-label small fw-semibold"></label>
                    <textarea asp-for="Message" rows="5" class="form-control" placeholder="How can we assist you today? Please share as much detail as possible..."></textarea>
                    <span asp-validation-for="Message" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-semibold d-inline-flex align-items-center gap-2">
                    <i class="bi bi-send-fill"></i>
                    <span>Submit Inquiry</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Operating Hours & Coverage Map -->
    <div class="col-lg-5">
        <div class="d-flex flex-column gap-4 h-100">
            <!-- Coverage Districts -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-geo-fill text-danger"></i>
                    <span>Active Coverage Zones</span>
                </h5>
                <p class="text-muted small mb-3">
                    Zyara doctors and nurses are currently on duty across the Greater Cairo and Giza regions:
                </p>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill text-primary me-1"></i>New Cairo & Rehab</span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill text-primary me-1"></i>Maadi & Katameya</span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill text-primary me-1"></i>Nasr City & Heliopolis</span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill text-primary me-1"></i>Dokki & Mohandessin</span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill text-primary me-1"></i>Zamalek & Downtown</span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill text-primary me-1"></i>Sheikh Zayed & 6th of October</span>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill text-primary me-1"></i>Shubra & El-Zaytoun</span>
                </div>
                <div class="p-3 bg-primary-subtle rounded-3 text-primary-emphasis small">
                    <i class="bi bi-info-circle me-1"></i> <strong>Expanding Soon:</strong> Alexandria, Tanta, and Mansoura coverage launches Q1 2027!
                </div>
            </div>

            <!-- Provider Partnership Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-gradient text-white" style="background: linear-gradient(135deg, var(--zy-primary-700, #1e40af), var(--zy-primary, #2563eb));">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-hospital fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Are you a Doctor or Nurse?</h5>
                        <small class="text-white-50">Join the Zyara Medical Network</small>
                    </div>
                </div>
                <p class="small text-white-75 mb-3">
                    Partner with Egypt's premier home healthcare network. Set your own arrival schedule, choose your home visit zones, and boost your clinical earnings with verified patients.
                </p>
                <a asp-controller="Register" asp-action="Index" class="btn btn-light rounded-pill fw-semibold text-primary px-4 py-2 w-100">
                    <i class="bi bi-person-badge me-1"></i> Apply as Healthcare Provider
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Frequently Asked Questions (FAQ Accordion - Vezeeta style) -->
<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5">
    <div class="text-center mb-4">
        <span class="badge rounded-pill bg-light text-secondary border px-3 py-1 mb-2">Help Center</span>
        <h3 class="fw-bold mb-1">Frequently Asked Questions</h3>
        <p class="text-muted small">Quick answers to common questions about Zyara home medical visits</p>
    </div>

    <div class="accordion accordion-flush" id="faqAccordion">
        <!-- FAQ 1 -->
        <div class="accordion-item border-bottom py-2">
            <h2 class="accordion-header" id="faqHead1">
                <button class="accordion-button collapsed fw-semibold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse1" aria-expanded="false" aria-controls="faqCollapse1">
                    <i class="bi bi-question-circle text-primary me-2"></i> How does a Zyara home medical visit work?
                </button>
            </h2>
            <div id="faqCollapse1" class="accordion-collapse collapse" aria-labelledby="faqHead1" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted small">
                    You select the required service (such as General Physician, Pediatric exam, Cardiology, Wound Dressing, etc.), choose your convenient 2-hour arrival window, and enter your home address. The verified healthcare provider reviews and accepts the visit, arriving at your doorstep with portable diagnostic equipment.
                </div>
            </div>
        </div>

        <!-- FAQ 2 -->
        <div class="accordion-item border-bottom py-2">
            <h2 class="accordion-header" id="faqHead2">
                <button class="accordion-button collapsed fw-semibold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse2" aria-expanded="false" aria-controls="faqCollapse2">
                    <i class="bi bi-shield-lock text-primary me-2"></i> How do I verify the identity of the visiting doctor or nurse?
                </button>
            </h2>
            <div id="faqCollapse2" class="accordion-collapse collapse" aria-labelledby="faqHead2" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted small">
                    Upon booking confirmation, the Zyara platform generates a unique, secure <strong>4-digit arrival OTP</strong> visible only in your confirmation card. When the provider arrives, you provide this OTP, which the provider enters in their portal to start the clinical visit. This guarantees mutual verification and patient safety.
                </div>
            </div>
        </div>

        <!-- FAQ 3 -->
        <div class="accordion-item border-bottom py-2">
            <h2 class="accordion-header" id="faqHead3">
                <button class="accordion-button collapsed fw-semibold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse3" aria-expanded="false" aria-controls="faqCollapse3">
                    <i class="bi bi-credit-card text-primary me-2"></i> What payment methods are accepted?
                </button>
            </h2>
            <div id="faqCollapse3" class="accordion-collapse collapse" aria-labelledby="faqHead3" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted small">
                    We support both <strong>Cash on Arrival</strong> (paid directly to the provider once the visit is completed) and <strong>Online Card Payments (Visa / Mastercard)</strong>. With card payments, funds are authorized (held) at booking and captured only when the visit is successfully completed.
                </div>
            </div>
        </div>

        <!-- FAQ 4 -->
        <div class="accordion-item border-bottom py-2">
            <h2 class="accordion-header" id="faqHead4">
                <button class="accordion-button collapsed fw-semibold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse4" aria-expanded="false" aria-controls="faqCollapse4">
                    <i class="bi bi-clock-history text-primary me-2"></i> What is the cancellation policy?
                </button>
            </h2>
            <div id="faqCollapse4" class="accordion-collapse collapse" aria-labelledby="faqHead4" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted small">
                    You can cancel your appointment prior to the arrival window through our customer hotline at <strong>16543</strong> or via WhatsApp. Any card authorizations will be immediately released with zero deduction.
                </div>
            </div>
        </div>

        <!-- FAQ 5 -->
        <div class="accordion-item py-2">
            <h2 class="accordion-header" id="faqHead5">
                <button class="accordion-button collapsed fw-semibold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse5" aria-expanded="false" aria-controls="faqCollapse5">
                    <i class="bi bi-patch-check text-primary me-2"></i> Are all healthcare providers licensed and verified?
                </button>
            </h2>
            <div id="faqCollapse5" class="accordion-collapse collapse" aria-labelledby="faqHead5" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted small">
                    Yes, 100%. Every doctor and nurse on Zyara undergoes strict manual credential verification by our medical administration board, including their Egyptian Medical Syndicate (EMS) license, national ID, and criminal background clearance before being permitted to accept visits.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

