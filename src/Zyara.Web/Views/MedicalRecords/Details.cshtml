@using Zyara.Services.Features.MedicalRecords.Dtos
@model PatientVisitRecordDto

@{
    ViewData["Title"] = "Visit record";
}

<section class="py-4" style="max-width: 820px; margin: auto;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 fw-bold mb-0">Visit record</h1>
        <a asp-controller="Booking" asp-action="Confirmation" asp-route-id="@Model.BookingId" class="btn btn-outline-primary btn-sm rounded-pill">Booking details</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <div class="fw-bold">@Model.ProviderName</div>
            <div class="text-muted small">Booking #@Model.BookingId · @Model.ServiceName · @Model.Date.ToString("ddd, dd MMM yyyy")</div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <h2 class="h5 fw-bold">Prescription</h2>
            @if (!Model.Items.Any())
            {
                <p class="text-muted mb-0">No prescription was written for this visit.</p>
            }
            else
            {
                <p class="text-muted small">Issued @Model.PrescriptionIssuedAt?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</p>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light"><tr><th>Medication</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Instructions</th></tr></thead>
                        <tbody>
                            @foreach (var i in Model.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">@i.MedicationName</td>
                                    <td>@i.Dosage</td>
                                    <td>@i.Frequency</td>
                                    <td>@i.Duration</td>
                                    <td>@i.Instructions</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <h2 class="h5 fw-bold">Service note</h2>
            @if (string.IsNullOrWhiteSpace(Model.Note))
            {
                <p class="text-muted mb-0">No note was added for this visit.</p>
            }
            else
            {
                <p class="mb-0" style="white-space: pre-line;">@Model.Note</p>
            }
        </div>
    </div>
</section>
