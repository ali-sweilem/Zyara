@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="auth-page"><div class="auth-card">
  <h2>Forgot Password</h2>
  <form asp-action="ForgotPassword" method="post" novalidate>
    <div class="auth-field"><label for="emailOrPhone">Email or phone</label><input id="emailOrPhone" name="emailOrPhone" class="auth-input" /></div>
    <button type="submit" class="auth-btn">Send code</button>
  </form>
</div></div>
