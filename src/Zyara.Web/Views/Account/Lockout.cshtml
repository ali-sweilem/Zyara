@{
    ViewData["Title"] = "Account locked";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <i class="bi bi-hourglass-split display-5 text-warning mb-3"></i>
                <h3 class="card-title mb-2">Account temporarily locked</h3>
                <p class="text-muted mb-4">
                    Too many failed sign-in attempts. Please wait a few minutes and try again.
                </p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Back to sign in</a>
            </div>
        </div>
    </div>
</div>
