@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="auth-page">
  <main class="auth-form-center">
    <div class="auth-card">
      <h2>Login</h2>
      <p>Secure access to your healthcare visits</p>
      @if (TempData["SuccessMessage"] != null)
      {
        <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
      }
      @if (ViewData.ModelState.ContainsKey(string.Empty))
      {
        <div class="alert" role="alert">@ViewData.ModelState[string.Empty].Errors.FirstOrDefault()?.ErrorMessage</div>
      }
      <form asp-action="Login" method="post" novalidate autocomplete="on" id="loginForm">
        <input type="hidden" name="__RequestVerificationToken" value="@Html.AntiForgeryToken()" />
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="auth-field"><label for="emailOrPhone">Email or phone</label><div class="input-with-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg><input id="emailOrPhone" name="emailOrPhone" class="auth-input" autocomplete="username" autofocus aria-required="true" placeholder="ali@example.com" /></div></div>

        <div class="auth-field"><label for="password">Password</label><div class="input-with-icon input-password"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><input id="password" name="password" type="password" class="auth-input" autocomplete="current-password" aria-required="true" /><button type="button" data-toggle-password="password" aria-label="Show password" class="btn-password"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button></div><div id="capsWarning" class="hidden" role="status" aria-live="polite">Caps Lock is ON</div></div>

        <div class="login-row"><a asp-action="ForgotPassword" class="auth-link">Forgot password?</a><label><input type="checkbox" name="RememberMe" value="true" /> Remember me</label></div>

        <button type="submit" id="btnSignIn" class="auth-btn">Sign in</button>

        <div>New here? <a asp-action="Register" class="auth-link">Create an account</a></div>
      </form>
    </div>
  </main>
</div>
<script src="~/js/auth.js" defer></script>
