@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="auth-page"><div class="auth-card">
  <h2>Reset Password</h2>
  <form asp-action="ResetPassword" method="post" novalidate id="otp-form">
    <div class="otp-row" role="group" aria-label="4-digit code">
      <input class="otp-box" type="text" inputmode="numeric" maxlength="1" aria-label="Digit 1" data-otp-index="1" />
      <input class="otp-box" type="text" inputmode="numeric" maxlength="1" aria-label="Digit 2" data-otp-index="2" />
      <input class="otp-box" type="text" inputmode="numeric" maxlength="1" aria-label="Digit 3" data-otp-index="3" />
      <input class="otp-box" type="text" inputmode="numeric" maxlength="1" aria-label="Digit 4" data-otp-index="4" />
    </div>
    <div class="auth-field"><label for="newPassword">New password</label><div class="input-with-icon input-password"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><input id="newPassword" name="newPassword" type="password" class="auth-input" /></div></div>
    <button type="submit" class="auth-btn">Reset</button>
  </form>
</div></div>
<script src="~/js/auth.js" defer></script>
