@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="auth-page">
  <main class="auth-form-center">
    <div class="auth-card wide">
      <div class="auth-header">
        <div><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-3H17"/></svg></div>
        <h2>Create Account</h2>
      </div>
      <form asp-action="Register" method="post" novalidate>
        <div>
          <label>I am a</label>
          <div class="role-pills">
            <button type="button" data-role="Patient" class="btn btn-outline-primary rounded-pill px-3 btn-role" id="btnPatient">Patient</button>
            <button type="button" data-role="Doctor" class="btn btn-outline-secondary rounded-pill px-3 btn-role" id="btnDoctor">Doctor</button>
            <button type="button" data-role="Nurse" class="btn btn-outline-secondary rounded-pill px-3 btn-role" id="btnNurse">Nurse</button>
          </div>
          <input type="hidden" name="Role" id="Role" value="Patient" />
        </div>

        <div class="auth-field"><label for="FullName">Full name</label><div class="input-with-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input id="FullName" name="FullName" class="auth-input" /></div></div>

        <div class="auth-field"><label>Gender</label><div class="gender-pills"><label class="pill"><input type="radio" name="Gender" value="Male" checked /> Male</label><label class="pill"><input type="radio" name="Gender" value="Female" /> Female</label></div></div>

        <div class="auth-field"><label for="Phone">Phone (+20)</label><div class="input-with-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><input id="Phone" name="Phone" class="auth-input" placeholder="+20 100 000 0000" /></div></div>

        <div class="auth-field"><label for="Email">Email</label><div class="input-with-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg><input id="Email" name="Email" type="email" class="auth-input" /></div></div>

        <div class="auth-field"><label for="Password">Password</label><div class="input-with-icon input-password">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <input id="Password" name="Password" type="password" class="auth-input" />
          <button type="button" data-toggle-password="Password" aria-label="Show password" class="btn-password"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
        </div></div>

        <div class="auth-field"><label for="ConfirmPassword">Confirm password</label><div class="input-with-icon input-password">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="auth-input" />
        </div></div>

        <div id="doctorOnly" class="hidden-field">
          <div class="auth-field"><label for="LicenseNumber">License number (Doctor only)</label><div class="input-with-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg><input id="LicenseNumber" name="LicenseNumber" class="auth-input" /></div></div>
        </div>

        <div class="auth-field"><label><input type="checkbox" name="TermsAccepted" /> I agree to terms and privacy</label></div>

        <button type="submit" class="auth-btn">Create account</button>
        <p>Already have an account? <a asp-action="Login" asp-controller="Account" class="auth-link">Login</a></p>
      </form>
    </div>
  </main>
</div>
<script src="~/js/auth.js" defer></script>
