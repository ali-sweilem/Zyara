@{
    ViewData["Title"] = "Sign in with Google";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="row justify-content-center my-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-body p-4 p-md-5">
                <!-- Google Header -->
                <div class="text-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 48 48" class="mb-3">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    </svg>
                    <h4 class="fw-bold mb-1">Sign in with Google</h4>
                    <p class="text-muted small mb-0">to continue to <strong>Zyara Healthcare</strong></p>
                </div>

                <!-- Dev Notice Badge -->
                <div class="alert alert-light border border-info-subtle rounded-3 py-2 px-3 mb-4 small text-muted d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill text-info fs-5"></i>
                    <div>
                        <strong>Demo / Development Mode:</strong> Choose a seeded patient profile or enter any email to sign in via Google.
                    </div>
                </div>

                <!-- 1-Click Fast Accounts -->
                <p class="text-muted small fw-semibold text-uppercase mb-2">Choose an existing account</p>
                <div class="list-group mb-4 shadow-sm rounded-3">
                    <form asp-action="DevGoogleSignIn" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <input type="hidden" name="email" value="ahmed.hassan@patient.test" />
                        <input type="hidden" name="fullName" value="Ahmed Hassan" />
                        <button type="submit" class="list-group-item list-group-item-action d-flex align-items-center p-3 border-bottom text-start">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3 fw-bold" style="width: 40px; height: 40px;">
                                AH
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold text-dark">Ahmed Hassan</div>
                                <div class="text-muted small">ahmed.hassan@patient.test</div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </button>
                    </form>

                    <form asp-action="DevGoogleSignIn" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <input type="hidden" name="email" value="sarah.nabil@patient.test" />
                        <input type="hidden" name="fullName" value="Sarah Nabil" />
                        <button type="submit" class="list-group-item list-group-item-action d-flex align-items-center p-3 text-start">
                            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-3 fw-bold" style="width: 40px; height: 40px;">
                                SN
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold text-dark">Sarah Nabil</div>
                                <div class="text-muted small">sarah.nabil@patient.test</div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </button>
                    </form>
                </div>

                <!-- Or Sign in with custom email -->
                <div class="position-relative text-center my-3">
                    <hr class="text-muted opacity-25">
                    <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 small text-muted">or use another email</span>
                </div>

                <form asp-action="DevGoogleSignIn" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    
                    <div class="mb-3">
                        <label class="form-label small fw-medium">Google Email</label>
                        <input type="email" name="email" class="form-control form-control-sm" placeholder="e.g. yourname@gmail.com" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-medium">Full Name (optional)</label>
                        <input type="text" name="fullName" class="form-control form-control-sm" placeholder="e.g. Tarek Omar" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold">
                        Continue as Google User
                    </button>
                </form>

                <div class="text-center mt-4">
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" class="text-decoration-none small text-muted">
                        <i class="bi bi-arrow-left me-1"></i>Back to regular login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

