@model AdminUsersIndexDto

@{
    ViewData["Title"] = "Manage Users";

    var routeValues = new Dictionary<string, string> { ["area"] = "Admin" };
    if (Model.Role.HasValue) routeValues["role"] = Model.Role.Value.ToString();
    if (!string.IsNullOrWhiteSpace(Model.Search)) routeValues["search"] = Model.Search;

    var pagination = new PaginationDto(Model.Users, "Index", "AdminUsers", routeValues, "page", null, "Users pages");
}

<div class="container py-4" style="max-width: 1100px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-primary fw-semibold small mb-1">Admin Panel</p>
            <h1 class="h3 fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i>Manage Users</h1>
        </div>
        <span class="badge bg-light text-secondary border rounded-pill px-3 py-2">@Model.Users.TotalCount total users</span>
    </div>

    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 py-2"><i class="bi bi-check-circle me-1"></i>@ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 py-2"><i class="bi bi-exclamation-circle me-1"></i>@err</div>
    }

    @* ── Filter & Search Bar ── *@
    <form method="get" class="card border rounded-3 bg-white mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input type="text" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by name, email, or phone..." />
                </div>
                <div class="col-md-3">
                    <select name="role" class="form-select"
                            asp-items="new SelectList(Enum.GetValues<UserRole>(), Model.Role)">
                        <option value="">All roles</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                </div>
                @if (Model.Role.HasValue || !string.IsNullOrWhiteSpace(Model.Search))
                {
                    <div class="col-auto">
                        <a asp-area="Admin" asp-controller="AdminUsers" asp-action="Index"
                           class="btn btn-outline-secondary rounded-pill px-3">Reset</a>
                    </div>
                }
            </div>
        </div>
    </form>

    @if (Model.Users.Items.Count == 0)
    {
        <div class="card border rounded-3 bg-white p-5 text-center text-muted">
            <i class="bi bi-people fs-1 mb-2 d-block"></i>
            No users found matching your criteria.
        </div>
    }
    else
    {
        <section class="card border rounded-3 bg-white overflow-hidden mb-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 bookings-table">
                    <thead>
                        <tr>
                            <th class="ps-4">Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Role</th>
                            <th>Joined</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users.Items)
                        {
                            var isSelf = u.Id == Model.CurrentAdminId;
                            var roleBadge = u.Role switch
                            {
                                UserRole.Admin => "bg-dark text-white",
                                UserRole.Doctor => "bg-primary-subtle text-primary-emphasis",
                                UserRole.Nurse => "bg-info-subtle text-info-emphasis",
                                _ => "bg-light text-dark border"
                            };
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">
                                    @u.FullName
                                    @if (isSelf)
                                    {
                                        <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill ms-1" style="font-size:.7rem;">You</span>
                                    }
                                </td>
                                <td class="small text-secondary">@u.Email</td>
                                <td class="small text-muted text-nowrap">@(string.IsNullOrWhiteSpace(u.PhoneNumber) ? "—" : u.PhoneNumber)</td>
                                <td class="text-nowrap"><span class="badge @roleBadge rounded-pill px-2 py-1">@u.Role</span></td>
                                <td class="small text-muted text-nowrap">@u.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-nowrap">
                                    <span class="badge @(u.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis") rounded-pill px-2 py-1">
                                        @(u.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    @if (isSelf)
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                    else
                                    {
                                        <form asp-area="Admin" asp-controller="AdminUsers" asp-action="Toggle" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <input type="hidden" name="role" value="@(Model.Role?.ToString())" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <input type="hidden" name="page" value="@Model.Users.Page" />
                                            <button type="submit"
                                                    class="btn btn-sm rounded-pill @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                    onclick="return confirm('@(u.IsActive ? "Deactivate this user? They will be signed out immediately." : "Activate this user?")')">
                                                @(u.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <partial name="_Pagination" model="pagination" />
    }
</div>
