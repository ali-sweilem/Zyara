@model AdminUsersIndexViewModel

@{
    ViewData["Title"] = "Manage Users";

    var routeValues = new Dictionary<string, string> { ["area"] = "Admin" };
    if (Model.Role.HasValue) routeValues["role"] = Model.Role.Value.ToString();

    var pagination = new PaginationViewModel(Model.Users, "Index", "AdminUsers", routeValues, "page", null, "Users pages");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Users</h2>
    <span class="text-muted small">@Model.Users.TotalCount total</span>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success py-2">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger py-2">@err</div>
}

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.Role is null ? "active" : "")" asp-area="Admin" asp-controller="AdminUsers" asp-action="Index">All</a>
    </li>
    @foreach (var r in Enum.GetValues<UserRole>())
    {
        <li class="nav-item">
            <a class="nav-link @(Model.Role == r ? "active" : "")" asp-area="Admin" asp-controller="AdminUsers" asp-action="Index" asp-route-role="@r">@r</a>
        </li>
    }
</ul>

@if (Model.Users.Items.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center text-muted">No users found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users.Items)
                {
                    <tr>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>@u.Role</td>
                        <td>
                            <span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">@(u.IsActive ? "Active" : "Inactive")</span>
                        </td>
                        <td class="text-end">
                            <form asp-area="Admin" asp-controller="AdminUsers" asp-action="Toggle" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@u.Id" />
                                <input type="hidden" name="role" value="@(Model.Role?.ToString())" />
                                <input type="hidden" name="page" value="@Model.Users.Page" />
                                <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(u.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" model="pagination" />
}