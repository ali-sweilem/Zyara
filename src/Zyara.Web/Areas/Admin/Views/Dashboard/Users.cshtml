@model List<Zyara.Domain.Entities.User>
@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
<div style="max-width:1280px;margin:0 auto;padding:2rem 1rem;">
  <h1 style="font-family:inherit;font-weight:700;color:var(--auth-text);font-size:1.5rem;">User Management</h1>
  <table class="table" style="background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(15,23,42,0.08);">
    <thead style="background:#0891b2;color:#fff;"><tr><th>Name</th><th>Role</th><th>Email</th><th>Phone</th><th>Active</th><th>Action</th></tr></thead>
    <tbody>
    @foreach (var u in Model) {
      <tr>
        <td>@u.FullName</td>
        <td>@u.Role</td>
        <td>@u.Email</td>
        <td>@u.Phone</td>
        <td>@(u.IsActive ? "Yes" : "No")</td>
        <td>
          <form asp-action="ToggleActive" method="post" style="display:inline;">
            <input type="hidden" name="id" value="@u.Id" />
            <input type="hidden" name="isActive" value="@( !u.IsActive ? "true" : "false" )" />
            <input type="hidden" name="__RequestVerificationToken" value="@Html.AntiForgeryToken()" />
            <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-secondary" : "btn-outline-success")">@(u.IsActive ? "Deactivate" : "Activate")</button>
          </form>
        </td>
      </tr>
    }
    </tbody>
  </table>
</div>
