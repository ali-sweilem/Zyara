@model IReadOnlyList<ServiceItemDto>

@{
    ViewData["Title"] = "Manage Services";
}

<div class="container py-4" style="max-width: 1100px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-primary fw-semibold small mb-1">Admin Panel</p>
            <h1 class="h3 fw-bold mb-0"><i class="bi bi-grid me-2 text-primary"></i>Services Catalog</h1>
        </div>
        <span class="badge bg-light text-secondary border rounded-pill px-3 py-2">@Model.Count total services</span>
    </div>

    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 py-2"><i class="bi bi-check-circle me-1"></i>@ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 py-2"><i class="bi bi-exclamation-circle me-1"></i>@err</div>
    }

    <div class="card border rounded-3 bg-white mb-4">
        <div class="card-body p-4">
            <h2 class="h6 fw-bold mb-3"><i class="bi bi-plus-circle me-1 text-primary"></i>Add a service to the catalog</h2>
            <form asp-area="Admin" asp-controller="AdminServices" asp-action="Create" method="post" class="row g-2">
                <div class="col-md-4"><input name="name" class="form-control" placeholder="Service name" maxlength="100" required /></div>
                <div class="col-md-3">
                    <select name="type" class="form-select">
                        <option value="DoctorHomeVisit">Doctor home visit</option>
                        <option value="NurseHomeVisit">Nurse home visit</option>
                        <option value="RemoteConsultation">Online consultation</option>
                    </select>
                </div>
                <div class="col-md-3"><input name="description" class="form-control" placeholder="Description (optional)" maxlength="500" /></div>
                <div class="col-md-2 d-grid"><button type="submit" class="btn btn-primary rounded-pill">Add</button></div>
            </form>
            <div class="form-text mt-2">Providers pick services from this catalog and set their own price.</div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border rounded-3 bg-white p-5 text-center text-muted">No services found.</div>
    }
    else
    {
        <section class="card border rounded-3 bg-white overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 bookings-table">
                    <thead>
                        <tr>
                            <th class="ps-4">Name</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@s.Name</td>
                                <td class="small text-muted" style="max-width:300px;">@(string.IsNullOrWhiteSpace(s.Description) ? "—" : s.Description)</td>
                                <td class="small text-nowrap">@s.Type</td>
                                <td class="text-nowrap">
                                    <span class="badge @(s.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis") rounded-pill px-2 py-1">
                                        @(s.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <div class="d-inline-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill"
                                                data-bs-toggle="modal" data-bs-target="#editServiceModal"
                                                data-svc-id="@s.Id"
                                                data-svc-name="@s.Name"
                                                data-svc-desc="@s.Description"
                                                data-svc-type="@s.Type">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </button>
                                        <form asp-area="Admin" asp-controller="AdminServices" asp-action="Toggle" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="btn btn-sm rounded-pill @(s.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                @(s.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@* ── Edit Service Modal ── *@
<div class="modal fade" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="editServiceModalLabel">Edit service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-area="Admin" asp-controller="AdminServices" asp-action="Update" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editSvcId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small" for="editSvcName">Service name</label>
                        <input id="editSvcName" name="name" class="form-control" maxlength="100" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small" for="editSvcType">Type</label>
                        <select id="editSvcType" name="type" class="form-select">
                            <option value="DoctorHomeVisit">Doctor home visit</option>
                            <option value="NurseHomeVisit">Nurse home visit</option>
                            <option value="RemoteConsultation">Online consultation</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small" for="editSvcDesc">Description (optional)</label>
                        <textarea id="editSvcDesc" name="description" class="form-control" rows="2" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('editServiceModal')?.addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('editSvcId').value = btn.dataset.svcId || '';
            document.getElementById('editSvcName').value = btn.dataset.svcName || '';
            document.getElementById('editSvcDesc').value = btn.dataset.svcDesc || '';
            document.getElementById('editSvcType').value = btn.dataset.svcType || 'DoctorHomeVisit';
        });
    </script>
}
