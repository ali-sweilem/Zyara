@model IReadOnlyList<PendingProviderDto>
@{
    ViewData["Title"] = "Review Providers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Providers waiting for review</h2>
    <span class="text-muted small">@Model.Count pending</span>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success py-2">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger py-2">@err</div>
}

@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center text-muted">No providers are waiting for review.</div>
}
else
{
    @foreach (var p in Model)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <div>
                        <h5 class="mb-1">@p.FullName <span class="badge bg-secondary">@p.Role</span></h5>
                        <div class="text-muted small">@p.Email</div>
                        <div class="small">@p.Specialty, @p.ExperienceYears years of experience@(string.IsNullOrEmpty(p.BaseCity) ? "" : " | " + p.BaseCity)</div>
                    </div>
                    <div>
                        <div class="small fw-semibold">Documents</div>
                        @if (p.Credentials.Count == 0)
                        {
                            <div class="text-muted small">No documents uploaded.</div>
                        }
                        else
                        {
                            foreach (var c in p.Credentials)
                            {
                                <div class="small">
                                    <a asp-area="" asp-controller="ProviderCredentials" asp-action="Download"
                                       asp-route-id="@c.Id" asp-route-providerId="@p.Id">@c.DocumentType (@c.FileExtension)</a>
                                </div>
                            }
                        }
                    </div>
                </div>

                <hr />

                <div class="d-flex flex-wrap gap-2 align-items-start">
                    <form asp-area="Admin" asp-controller="AdminProviders" asp-action="Review" method="post">
                        <input type="hidden" name="id" value="@p.Id" />
                        <input type="hidden" name="approve" value="true" />
                        <button class="btn btn-success btn-sm">Approve</button>
                    </form>

                    <form asp-area="Admin" asp-controller="AdminProviders" asp-action="Review" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@p.Id" />
                        <input type="hidden" name="approve" value="false" />
                        <input name="reason" class="form-control form-control-sm" placeholder="Reason for rejection" required maxlength="500" />
                        <button class="btn btn-outline-danger btn-sm">Reject</button>
                    </form>
                </div>
            </div>
        </div>
    }
}