@model PagedResult<AdminBookingDto>
@{
    ViewData["Title"] = "Bookings";
    var selected = ViewData["Status"] as BookingStatus?;
    var search = ViewData["Search"] as string;

    var routeValues = new Dictionary<string, string> { ["area"] = "Admin" };
    if (selected.HasValue) routeValues["status"] = selected.Value.ToString();
    if (!string.IsNullOrWhiteSpace(search)) routeValues["search"] = search;

    var pagination = new PaginationDto(Model, "Index", "AdminBookings", routeValues, "page", null, "Bookings pages");

    (string Cls, string Label) StatusBadge(BookingStatus s) => s switch
    {
        BookingStatus.PendingProviderApproval => ("bg-warning-subtle text-warning-emphasis", "Pending Approval"),
        BookingStatus.Confirmed => ("bg-primary-subtle text-primary-emphasis", "Confirmed"),
        BookingStatus.ConfirmedCollectionPending => ("bg-primary-subtle text-primary-emphasis", "Confirmed"),
        BookingStatus.Started => ("bg-info-subtle text-info-emphasis", "Started"),
        BookingStatus.Completed => ("bg-success-subtle text-success-emphasis", "Completed"),
        BookingStatus.Cancelled => ("bg-secondary-subtle text-secondary-emphasis", "Cancelled"),
        BookingStatus.Rejected => ("bg-danger-subtle text-danger-emphasis", "Rejected"),
        BookingStatus.Expired => ("bg-secondary-subtle text-secondary-emphasis", "Expired"),
        BookingStatus.NoShow => ("bg-danger-subtle text-danger-emphasis", "No Show"),
        _ => ("bg-light text-dark", s.ToString())
    };
}

<div class="container py-4" style="max-width: 1100px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-primary fw-semibold small mb-1">Admin Panel</p>
            <h1 class="h3 fw-bold mb-0"><i class="bi bi-calendar2-check me-2 text-primary"></i>Manage Bookings</h1>
        </div>
        <span class="badge bg-light text-secondary border rounded-pill px-3 py-2">@Model.TotalCount total bookings</span>
    </div>

    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 py-2"><i class="bi bi-check-circle me-1"></i>@ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 py-2"><i class="bi bi-exclamation-circle me-1"></i>@err</div>
    }

    @* ── Filter & Search Bar ── *@
    <form method="get" class="card border rounded-3 bg-white mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input type="text" name="search" value="@search" class="form-control"
                           placeholder="Search by #ID, patient, provider, or service..." />
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select"
                            asp-items="new SelectList(Enum.GetValues<BookingStatus>(), selected)">
                        <option value="">All statuses</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                </div>
                @if (selected.HasValue || !string.IsNullOrWhiteSpace(search))
                {
                    <div class="col-auto">
                        <a asp-area="Admin" asp-controller="AdminBookings" asp-action="Index"
                           class="btn btn-outline-secondary rounded-pill px-3">Reset</a>
                    </div>
                }
            </div>
        </div>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="card border rounded-3 bg-white p-5 text-center text-muted">
            <i class="bi bi-calendar-x fs-1 mb-2 d-block"></i>
            No bookings found.
        </div>
    }
    else
    {
        <section class="card border rounded-3 bg-white overflow-hidden mb-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 bookings-table">
                    <thead>
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Patient</th>
                            <th>Provider</th>
                            <th>Service</th>
                            <th>Date &amp; Time</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Items)
                        {
                            var badge = StatusBadge(b.Status);
                            var canCancel = b.Status is BookingStatus.PendingProviderApproval or BookingStatus.Confirmed or BookingStatus.ConfirmedCollectionPending;
                            <tr>
                                <td class="ps-4 text-muted small fw-semibold">#@b.Id</td>
                                <td class="fw-medium text-dark">@b.PatientName</td>
                                <td class="text-secondary">@b.ProviderName</td>
                                <td class="small">@b.ServiceName</td>
                                <td class="small text-nowrap">
                                    <span class="fw-medium text-dark">@b.Date.ToString("dd MMM yyyy")</span>
                                    <span class="text-muted ms-1">· @b.StartTime.ToString(@"hh\:mm")</span>
                                </td>
                                <td class="fw-semibold text-nowrap">@b.TotalPrice.ToString("0.##") <small class="text-muted fw-normal">EGP</small></td>
                                <td class="text-nowrap"><span class="badge @badge.Cls rounded-pill px-2 py-1">@badge.Label</span></td>
                                <td class="small text-muted text-nowrap">@(b.PaymentStatus?.ToString() ?? "—")</td>
                                <td class="text-end pe-4 text-nowrap">
                                    @if (canCancel)
                                    {
                                        <form asp-area="Admin" asp-controller="AdminBookings" asp-action="Cancel" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@b.Id" />
                                            <input type="hidden" name="status" value="@(selected?.ToString())" />
                                            <input type="hidden" name="search" value="@search" />
                                            <input type="hidden" name="page" value="@Model.Page" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill"
                                                    onclick="return confirm('Cancel booking #@b.Id? Both patient and provider will be notified.')">
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <partial name="_Pagination" model="pagination" />
    }
</div>
