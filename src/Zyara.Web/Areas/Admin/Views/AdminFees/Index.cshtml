@model PlatformSettingsDto

@{
    ViewData["Title"] = "Platform Fees";
}

<div class="container py-4" style="max-width: 680px;">
    <div class="mb-4">
        <p class="text-primary fw-semibold small mb-1">Admin Panel</p>
        <h1 class="h3 fw-bold mb-1"><i class="bi bi-percent me-2 text-primary"></i>Platform Fees</h1>
        <p class="text-muted mb-0">Configure the platform service fee and provider commission rate.</p>
    </div>

    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 py-2"><i class="bi bi-check-circle me-1"></i>@ok</div>
    }

    <div class="card border rounded-3 bg-white">
        <div class="card-body p-4">
            <form asp-area="Admin" asp-controller="AdminFees" asp-action="Update" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ServiceFee" class="form-label fw-semibold small">Service Fee (EGP)</label>
                    <input asp-for="ServiceFee" type="number" step="0.01" min="0" class="form-control" />
                    <div class="form-text">Fixed fee added to each patient booking.</div>
                    <span asp-validation-for="ServiceFee" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="CommissionPercentage" class="form-label fw-semibold small">Commission Percentage (%)</label>
                    <input asp-for="CommissionPercentage" type="number" step="0.01" min="0" max="100" class="form-control" />
                    <div class="form-text">Percentage deducted from the provider's service price (0 – 100%).</div>
                    <span asp-validation-for="CommissionPercentage" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-check2-circle me-1"></i>Save changes
                </button>
            </form>
        </div>
    </div>
</div>
