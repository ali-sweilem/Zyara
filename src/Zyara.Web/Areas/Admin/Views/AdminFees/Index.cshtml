@model PlatformSettingsDto

@{
    ViewData["Title"] = "Platform Fees";
}


<h2 class="h4 fw-bold mb-3">Platform fees</h2>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success py-2">@ok</div>
}

<div class="card border-0 shadow-sm rounded-4" style="max-width: 520px;">
    <div class="card-body p-4">
        <form asp-area="Admin" asp-controller="AdminFees" asp-action="Update" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="ServiceFeePercentage" class="form-label fw-semibold"></label>
                <input asp-for="ServiceFeePercentage" type="number" step="0.01" min="0" max="100" class="form-control" />
                <span asp-validation-for="ServiceFeePercentage" class="text-danger small"></span>
                <div class="form-text">
                    The platform's share of every completed visit. It is deducted from the provider's earnings;
                    the patient pays only the service price.
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="CommissionPercentage" class="form-label fw-semibold"></label>
                <input asp-for="CommissionPercentage" type="number" step="0.01" min="0" max="100" class="form-control" />
                <span asp-validation-for="CommissionPercentage" class="text-danger small"></span>
                <div class="form-text">
                    Charged for a late cancellation: when a patient cancels a confirmed booking less than 1 hour before the visit
                    (it is paid to the provider as compensation), and when a provider cancels a confirmed booking on the day of the visit
                    (it is deducted from the provider's wallet). A provider who does this twice in a week stops receiving new bookings
                    until the week ends or an admin resets him.
                </div>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill px-4">Save</button>
        </form>
    </div>
</div>

