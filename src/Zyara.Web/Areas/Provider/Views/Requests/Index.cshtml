@model IReadOnlyList<Zyara.Services.Features.Providers.Dtos.ProviderRequestCardDto>

@{
    ViewData["Title"] = "Pending Booking Requests";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1">Incoming Requests</h2>
        <p class="text-muted small mb-0">Accept or decline patient booking requests awaiting your clinical confirmation.</p>
    </div>
    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fs-6 fw-semibold">
        @Model.Count Waiting
    </span>
</div>

@if (Model.Count == 0)
{
    <div class="med-card text-center p-5">
        <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
        <h3 class="h5 fw-bold text-dark">No Pending Requests</h3>
        <p class="text-muted small mb-4">All requests have been addressed. Make sure your schedule has open arrival windows so patients can book.</p>
        <a asp-area="Provider" asp-controller="Schedule" asp-action="Index" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-calendar-plus me-1"></i> Check Working Schedule
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var req in Model)
        {
            <div class="col-lg-6">
                <div class="med-card h-100 d-flex flex-column">
                    <div class="med-card-header bg-white d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 py-1 fw-bold">
                                Pending Approval
                            </span>
                            <span class="text-muted small">#@req.BookingId</span>
                        </div>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 small fw-semibold">
                            <i class="bi bi-hourglass-split me-1"></i>@req.TimeLeftDisplay
                        </span>
                    </div>

                    <div class="p-4 flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h3 class="h5 fw-bold text-dark mb-1">@req.PatientName</h3>
                                <div class="text-muted small">
                                    <i class="bi bi-shield-lock-fill text-secondary me-1"></i>
                                    Phone & Address: <span class="fst-italic text-secondary">Shown after you accept</span>
                                </div>
                            </div>
                            <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                                @if (req.ServiceType == ServiceType.DoctorHomeVisit)
                                {
                                    <i class="bi bi-house-door-fill text-primary me-1"></i>
                                }
                                else if (req.ServiceType == ServiceType.NurseHomeVisit)
                                {
                                    <i class="bi bi-heart-pulse-fill text-danger me-1"></i>
                                }
                                else
                                {
                                    <i class="bi bi-camera-video-fill text-info me-1"></i>
                                }
                                @req.ServiceType
                            </span>
                        </div>

                        <!-- Service & Window Details -->
                        <div class="bg-light rounded-3 p-3 mb-3">
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <span class="text-muted small d-block">Requested Service:</span>
                                    <strong class="text-dark">@req.ServiceName</strong>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted small d-block">Arrival Window:</span>
                                    <strong class="text-primary">
                                        <i class="bi bi-clock me-1"></i>@req.DayLabel, @req.FormattedWindow
                                    </strong>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(req.PatientNotes))
                            {
                                <div class="mt-2 pt-2 border-top">
                                    <span class="text-muted small d-block">Patient Medical Notes:</span>
                                    <div class="small text-dark fst-italic">"@req.PatientNotes"</div>
                                </div>
                            }
                        </div>

                        <!-- Payment & Price Breakdown -->
                        <div class="p-3 border rounded-3 bg-white mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Payment Method:</span>
                                <span class="badge @(req.PaymentMethod == PaymentMethod.CashOnArrival ? "bg-light text-dark border" : "bg-primary-subtle text-primary border") rounded-pill">
                                    @(req.PaymentMethod == PaymentMethod.CashOnArrival ? "Cash on Arrival (Collect on completion)" : "Card Pre-Authorized (Hold placed)")
                                </span>
                            </div>
                            <div class="d-flex justify-content-between text-muted small mb-1">
                                <span>Patient Total:</span>
                                <span>@req.TotalPrice.ToString("N2") EGP</span>
                            </div>
                            <div class="d-flex justify-content-between text-muted small mb-1">
                                <span>Platform Service Fee:</span>
                                <span>- @req.ServiceFee.ToString("N2") EGP</span>
                            </div>
                            <div class="d-flex justify-content-between text-muted small mb-2">
                                <span>Platform Commission:</span>
                                <span>- @req.Commission.ToString("N2") EGP</span>
                            </div>
                            <div class="d-flex justify-content-between fw-bold text-dark pt-2 border-top">
                                <span>Your Estimated Net Earnings:</span>
                                <span class="text-success fs-6">@req.NetEarnings.ToString("N2") EGP</span>
                            </div>
                        </div>
                    </div>

                    <!-- Card Actions -->
                    <div class="p-3 bg-light border-top d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-danger rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#rejectModal-@req.BookingId">
                            <i class="bi bi-x-circle me-1"></i> Decline
                        </button>
                        <form asp-area="Provider" asp-controller="Requests" asp-action="Accept" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@req.BookingId" />
                            <button type="submit" class="btn btn-success rounded-pill px-4">
                                <i class="bi bi-check2-circle me-1"></i> Accept Request
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Decline Modal -->
            <div class="modal fade" id="rejectModal-@req.BookingId" tabindex="-1" aria-labelledby="modalLabel-@req.BookingId" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4 border-0">
                        <form asp-area="Provider" asp-controller="Requests" asp-action="Reject" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@req.BookingId" />
                            <div class="modal-header border-bottom-0 pb-0">
                                <h5 class="modal-title fw-bold" id="modalLabel-@req.BookingId">Decline Booking #@req.BookingId</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted small mb-3">
                                    Declining releases the time slot window for other patients and releases any card hold back to the patient. Please enter a reason (10 to 300 characters):
                                </p>
                                <div class="mb-3">
                                    <textarea name="reason" rows="3" class="form-control rounded-3" placeholder="Reason for declining this request..." required minlength="10" maxlength="300"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer border-top-0 pt-0">
                                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger rounded-pill">Confirm Decline</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
