@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Zyara.Domain.Enums
@{
    Layout = "_Layout";
    ViewData["Title"] = "Provider Dashboard";

    var providerId = (int)(ViewData["ProviderId"] ?? 0);
    var fullName = ViewData["FullName"] as string ?? "Provider";
    var verificationStatus = (VerificationStatus)(ViewData["VerificationStatus"] ?? VerificationStatus.Pending);
    var rejectionReason = ViewData["RejectionReason"] as string;
    var walletBalance = (decimal)(ViewData["WalletBalance"] ?? 0m);
    var averageRating = (double)(ViewData["AverageRating"] ?? 0.0);
    var ratingCount = (int)(ViewData["RatingCount"] ?? 0);
    var pendingCount = (int)(ViewData["PendingCount"] ?? 0);
    var activeCount = (int)(ViewData["ActiveCount"] ?? 0);
    var servicesCount = (int)(ViewData["ServicesCount"] ?? 0);
    var upcomingSlotsCount = (int)(ViewData["UpcomingSlotsCount"] ?? 0);
    var credentialsCount = (int)(ViewData["CredentialsCount"] ?? 0);
}

<div class="container py-4" dir="ltr" lang="en" style="max-width: 1100px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-primary fw-semibold small mb-1">Provider Portal</p>
            <h1 class="h3 fw-bold mb-1">Welcome back, @fullName</h1>
            <p class="text-muted mb-0">Here is a quick overview of your practice today.</p>
        </div>
        <a asp-area="" asp-controller="Providers" asp-action="Details" asp-route-id="@providerId"
           class="btn btn-outline-primary rounded-pill px-4">
            <i class="bi bi-eye me-1"></i>View Public Profile
        </a>
    </div>

    @* ── Verification Alert (Only if not verified) ── *@
    @if (verificationStatus == VerificationStatus.Pending)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-3 d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <div>
                <i class="bi bi-clock-history me-2"></i>
                <strong>Account under review:</strong> You cannot receive patient bookings until an admin verifies your documents.
            </div>
            <a asp-area="" asp-controller="ProviderCredentials" asp-action="Index" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                Manage Documents (@credentialsCount)
            </a>
        </div>
    }
    else if (verificationStatus == VerificationStatus.Rejected)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <div>
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Verification rejected:</strong> @(string.IsNullOrWhiteSpace(rejectionReason) ? "Please update your documents." : rejectionReason)
            </div>
            <a asp-area="" asp-controller="ProviderCredentials" asp-action="Index" class="btn btn-sm btn-danger rounded-pill px-3">
                Update Documents
            </a>
        </div>
    }

    @* ── Setup Checklist (If missing services or schedule) ── *@
    @if (servicesCount == 0 || upcomingSlotsCount == 0)
    {
        <div class="card border rounded-3 bg-white mb-4">
            <div class="card-body p-4">
                <h2 class="h6 fw-bold mb-2"><i class="bi bi-list-check me-2 text-primary"></i>Complete your setup to start receiving bookings</h2>
                <div class="d-flex flex-wrap gap-3 mt-2">
                    <a asp-area="Provider" asp-controller="Services" asp-action="Index"
                       class="text-decoration-none d-flex align-items-center gap-2 small @(servicesCount > 0 ? "text-success" : "text-dark fw-semibold")">
                        <i class="bi @(servicesCount > 0 ? "bi-check-circle-fill" : "bi-circle")"></i>
                        1. Add at least one service (@servicesCount added)
                    </a>
                    <a asp-area="Provider" asp-controller="Schedule" asp-action="Index"
                       class="text-decoration-none d-flex align-items-center gap-2 small @(upcomingSlotsCount > 0 ? "text-success" : "text-dark fw-semibold")">
                        <i class="bi @(upcomingSlotsCount > 0 ? "bi-check-circle-fill" : "bi-circle")"></i>
                        2. Add available time slots (@upcomingSlotsCount upcoming)
                    </a>
                </div>
            </div>
        </div>
    }

    @* ── 4 Key Stat Cards ── *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <a asp-area="Provider" asp-controller="Bookings" asp-action="Index" class="text-decoration-none text-reset">
                <div class="card border rounded-3 bg-white h-100">
                    <div class="card-body p-3">
                        <div class="text-muted small mb-1"><i class="bi bi-inbox me-1 text-warning"></i>Pending Requests</div>
                        <div class="h3 fw-bold mb-0 @(pendingCount > 0 ? "text-primary" : "text-dark")">@pendingCount</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-area="Provider" asp-controller="Bookings" asp-action="Index" class="text-decoration-none text-reset">
                <div class="card border rounded-3 bg-white h-100">
                    <div class="card-body p-3">
                        <div class="text-muted small mb-1"><i class="bi bi-calendar2-check me-1 text-primary"></i>Upcoming Visits</div>
                        <div class="h3 fw-bold text-dark mb-0">@activeCount</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-area="Provider" asp-controller="Wallet" asp-action="Index" class="text-decoration-none text-reset">
                <div class="card border rounded-3 bg-white h-100">
                    <div class="card-body p-3">
                        <div class="text-muted small mb-1"><i class="bi bi-wallet2 me-1 text-success"></i>Wallet Balance</div>
                        <div class="h3 fw-bold mb-0 @(walletBalance < 0 ? "text-danger" : "text-dark")">@walletBalance.ToString("N0") <small class="fs-6 fw-normal text-muted">EGP</small></div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-area="" asp-controller="Providers" asp-action="Details" asp-route-id="@providerId" asp-fragment="reviews" class="text-decoration-none text-reset">
                <div class="card border rounded-3 bg-white h-100">
                    <div class="card-body p-3">
                        <div class="text-muted small mb-1"><i class="bi bi-star-fill me-1 text-warning"></i>Rating</div>
                        <div class="h3 fw-bold text-dark mb-0">@averageRating.ToString("0.0") <small class="fs-6 fw-normal text-muted">(@ratingCount)</small></div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    @* ── Clear Navigation Grid ── *@
    <h2 class="h5 fw-bold mb-3">Quick Management</h2>
    <div class="row g-3">
        <div class="col-md-6">
            <a asp-area="Provider" asp-controller="Bookings" asp-action="Index" class="card border rounded-3 bg-white text-decoration-none text-reset h-100">
                <div class="card-body p-4 d-flex align-items-start gap-3">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3"><i class="bi bi-calendar2-check fs-4"></i></div>
                    <div>
                        <h3 class="h6 fw-bold mb-1">Bookings &amp; Visits</h3>
                        <p class="text-muted small mb-0">Accept or reject new requests, start visits with patient OTP, write prescriptions, and view history.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-area="Provider" asp-controller="Schedule" asp-action="Index" class="card border rounded-3 bg-white text-decoration-none text-reset h-100">
                <div class="card-body p-4 d-flex align-items-start gap-3">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3"><i class="bi bi-clock fs-4"></i></div>
                    <div>
                        <h3 class="h6 fw-bold mb-1">Working Schedule</h3>
                        <p class="text-muted small mb-0">Add 2-hour availability slots or set fixed weekly hours. Currently @upcomingSlotsCount upcoming available slots.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-area="Provider" asp-controller="Services" asp-action="Index" class="card border rounded-3 bg-white text-decoration-none text-reset h-100">
                <div class="card-body p-4 d-flex align-items-start gap-3">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3"><i class="bi bi-briefcase-medical fs-4"></i></div>
                    <div>
                        <h3 class="h6 fw-bold mb-1">My Services &amp; Pricing</h3>
                        <p class="text-muted small mb-0">Choose the services you offer from the catalog and set your consultation fees. (@servicesCount active)</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-area="Provider" asp-controller="Wallet" asp-action="Index" class="card border rounded-3 bg-white text-decoration-none text-reset h-100">
                <div class="card-body p-4 d-flex align-items-start gap-3">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3"><i class="bi bi-wallet2 fs-4"></i></div>
                    <div>
                        <h3 class="h6 fw-bold mb-1">Wallet &amp; Payouts</h3>
                        <p class="text-muted small mb-0">Track your online earnings, cash commissions, and request withdrawals.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

