@using Zyara.Domain.Enums
@model Zyara.Web.Areas.Provider.ViewModels.ProviderTimeSlotIndexVM

@{
    Layout = "_Layout";
    ViewData["Title"] = "إدارة المواعيد المتاحة (TimeSlots)";
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Form: إضافة TimeSlot جديد -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-clock-plus me-2"></i>إضافة TimeSlot جديد
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateTimeSlot" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">التاريخ</label>
                            <input type="date" class="form-control" asp-for="NewTimeSlot.Date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="NewTimeSlot.Date" class="text-danger small"></span>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold">من الساعة</label>
                                <input type="time" class="form-control" asp-for="NewTimeSlot.StartTime" />
                                <span asp-validation-for="NewTimeSlot.StartTime" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold">إلى الساعة</label>
                                <input type="time" class="form-control" asp-for="NewTimeSlot.EndTime" />
                                <span asp-validation-for="NewTimeSlot.EndTime" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">مدة الجلسة (بالدقائق)</label>
                            <input type="number" class="form-control" asp-for="NewTimeSlot.SlotDurationMinutes" step="5" min="15" max="120" />
                            <span asp-validation-for="NewTimeSlot.SlotDurationMinutes" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                            <i class="bi bi-plus-circle me-1"></i> إضافة الـ TimeSlot
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Table: قائمة المواعيد -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-calendar-week me-2 text-primary"></i>قائمة المواعيد (TimeSlots)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-center">
                            <thead class="table-light">
                                <tr>
                                    <th>التاريخ</th>
                                    <th>الوقت</th>
                                    <th>الحالة (Status)</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model?.TimeSlots != null && Model.TimeSlots.Any())
                                {
                                    @foreach (var slot in Model.TimeSlots)
                                    {
                                        <tr>
                                            <td class="fw-bold">@slot.Date.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                @DateTime.Today.Add(slot.StartTime).ToString("hh:mm tt") -
                                                @DateTime.Today.Add(slot.EndTime).ToString("hh:mm tt")
                                            </td>
                                            <td>
                                                @if (slot.Status == TimeSlotStatus.Available)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">Available</span>
                                                }
                                                else if (slot.Status == TimeSlotStatus.Locked)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill">Locked</span>
                                                }
                                                else if (slot.Status == TimeSlotStatus.Booked)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">Booked</span>
                                                }
                                            </td>
                                            <td>
                                                @if (slot.Status == TimeSlotStatus.Available)
                                                {
                                                    <form asp-action="DeleteTimeSlot" asp-route-id="@slot.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-2" onclick="return confirm('هل أنت متأكد من حذف هذا الموعد؟')">
                                                            <i class="bi bi-trash"></i> حذف
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-secondary btn-sm rounded-2" disabled>محتجز / محجوز</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            لا توجد مواعيد مضافة حالياً.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}