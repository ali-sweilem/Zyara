@model Zyara.Web.Areas.Provider.ViewModels.ScheduleViewModel
@{
    string currentRole = ViewBag.CurrentRole as string ?? "Doctor";
    ViewData["Title"] = "Availability & Schedule";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-clock-history text-primary me-2"></i> Availability & Schedule
        </h2>
        <p class="text-muted mb-0">Control your working hours and add slots for home visit appointments.</p>
    </div>
    <div>
        <button class="btn btn-med-primary" data-bs-toggle="modal" data-bs-target="#addSlotModal">
            <i class="bi bi-plus-circle me-1"></i> Add Availability Slot
        </button>
    </div>
</div>

<!-- Date Navigation Pills -->
<div class="med-card mb-4">
    <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="text-muted small fw-semibold me-2">Jump to date:</span>
            @for (int i = 0; i < 5; i++)
            {
                var d = DateTime.Today.AddDays(i);
                bool isSelected = d.Date == Model.SelectedDate.Date;
                <a asp-action="Index" asp-route-date="@d.ToString("yyyy-MM-dd")" asp-route-role="@currentRole" 
                   class="btn btn-sm rounded-pill px-3 @(isSelected ? "btn-med-primary" : "btn-outline-secondary bg-white")">
                    @(i == 0 ? "Today" : i == 1 ? "Tomorrow" : d.ToString("ddd, dd MMM"))
                </a>
            }
        </div>
        <div class="d-flex align-items-center gap-3 small text-muted">
            <span><i class="bi bi-circle-fill text-success me-1"></i> Available</span>
            <span><i class="bi bi-circle-fill text-primary me-1"></i> Booked</span>
            <span><i class="bi bi-circle-fill text-warning me-1"></i> Locked</span>
        </div>
    </div>

    <!-- Slots Grid -->
    <div class="med-card-body p-4">
        <h4 class="fw-bold text-dark mb-3">
            Schedule for @Model.SelectedDate.ToString("dddd, dd MMMM yyyy")
        </h4>

        <div class="row g-3">
            @foreach (var slot in Model.Slots)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="p-3 border rounded-3 position-relative @(slot.Status == TimeSlotStatus.Booked ? "bg-primary-subtle border-primary-subtle" : "bg-white shadow-sm")">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold fs-6 text-dark">
                                <i class="bi bi-clock text-teal-600 me-1"></i>
                                @DateTime.Today.Add(slot.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(slot.EndTime).ToString("hh:mm tt")
                            </span>
                            @if (slot.Status == TimeSlotStatus.Available)
                            {
                                <span class="badge bg-success-subtle text-success">Available</span>
                            }
                            else if (slot.Status == TimeSlotStatus.Booked)
                            {
                                <span class="badge bg-primary text-white">Booked</span>
                            }
                        </div>

                        @if (slot.Status == TimeSlotStatus.Booked)
                        {
                            <div class="small text-primary fw-semibold">
                                <i class="bi bi-person-fill me-1"></i> Patient: @slot.PatientName
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <small class="text-muted">Open for booking</small>
                                <form asp-action="Delete" asp-route-id="@slot.Id" asp-route-role="@currentRole" method="post" onsubmit="return confirm('Remove this slot?');">
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add Slot Modal -->
<div class="modal fade" id="addSlotModal" tabindex="-1" aria-labelledby="addSlotModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="addSlotModalLabel">
                    <i class="bi bi-calendar-plus text-primary me-2"></i> Add Availability Slot
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" asp-route-role="@currentRole" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Date</label>
                        <input type="date" name="NewSlotDate" class="form-control" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small fw-semibold">Start Time</label>
                            <input type="time" name="NewSlotStart" class="form-control" value="10:00" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small fw-semibold">End Time</label>
                            <input type="time" name="NewSlotEnd" class="form-control" value="11:00" required />
                        </div>
                    </div>
                    <div class="p-3 bg-light rounded-3 text-muted small">
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        Patients in your service city will be able to book this slot for home visits.
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-med-primary">Save Slot</button>
                </div>
            </form>
        </div>
    </div>
</div>

