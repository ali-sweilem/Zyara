@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Zyara.Domain.Enums
@model Zyara.Services.Features.Providers.Dtos.ProviderTimeSlotIndexDto

@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Schedule";

    // Egypt week starts on Saturday
    var weekDays = new[]
    {
        (Day: DayOfWeek.Saturday, Short: "Sat"),
        (Day: DayOfWeek.Sunday, Short: "Sun"),
        (Day: DayOfWeek.Monday, Short: "Mon"),
        (Day: DayOfWeek.Tuesday, Short: "Tue"),
        (Day: DayOfWeek.Wednesday, Short: "Wed"),
        (Day: DayOfWeek.Thursday, Short: "Thu"),
        (Day: DayOfWeek.Friday, Short: "Fri")
    };

    var showPast = (ViewData["ShowPast"] as bool?) == true;
    var upcomingCount = (int)(ViewData["UpcomingCount"] ?? 0);
    var pastCount = (int)(ViewData["PastCount"] ?? 0);
    var groupedSlots = (Model.TimeSlots ?? new())
        .GroupBy(s => s.Date.Date)
        .ToList();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    .flatpickr-calendar {
        direction: ltr;
    }
</style>

<div class="container py-4" dir="ltr" lang="en" style="max-width: 1100px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <p class="text-primary fw-semibold small mb-1">Provider Portal</p>
            <h1 class="h3 fw-bold mb-1"><i class="bi bi-calendar-week me-2 text-primary"></i>Manage Schedule</h1>
            <p class="text-muted mb-0">Set your weekly shifts once or add single 2-hour slots.</p>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @* ── Left Column: Weekly Shift Generator + Single Slot ── *@
        <div class="col-lg-4">
            @* 1. Weekly Shift Generator *@
            <div class="card border rounded-3 bg-white">
                <div class="card-header bg-white border-bottom py-3">
                    <h2 class="h6 card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-arrow-repeat me-2 text-primary"></i>Weekly Shift Generator
                    </h2>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-3">
                        Pick your working days and shift hours. 2-hour slots are generated automatically for the next 4 weeks.
                    </p>

                    <form action="/Provider/Schedule/AddWeeklyShift" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold small d-block">Days</label>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var d in weekDays)
                                {
                                    <input type="checkbox" class="btn-check" name="days" value="@((int)d.Day)" id="day_@d.Short" autocomplete="off" />
                                    <label class="btn btn-outline-primary btn-sm rounded-pill px-2" for="day_@d.Short" style="min-height: 32px; font-size: .8rem;">
                                        @d.Short
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold small">From</label>
                                <input type="text" name="startTime" class="form-control timepicker bg-white" placeholder="Start" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold small">To</label>
                                <input type="text" name="endTime" class="form-control timepicker bg-white" placeholder="End" required />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill">
                            <i class="bi bi-magic me-1"></i> Generate Weekly Slots
                        </button>
                    </form>

                    @if (Model.WeeklySlots.Any())
                    {
                        <hr class="my-4" />
                        <div class="small fw-bold mb-2">Active Weekly Times (@Model.WeeklySlots.Count)</div>
                        <ul class="list-group list-group-flush">
                            @foreach (var w in Model.WeeklySlots)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                    <span class="small">
                                        <strong>@w.DayOfWeek</strong>
                                        <span class="text-muted ms-1">
                                            @DateTime.Today.Add(w.StartTime).ToString("hh:mm tt") –
                                            @DateTime.Today.Add(w.EndTime).ToString("hh:mm tt")
                                        </span>
                                    </span>
                                    <form action="/Provider/Schedule/RemoveWeekly/@w.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" style="min-height:30px;"
                                                onclick="return confirm('Stop repeating this time? Its free upcoming slots will be deleted (booked ones stay).')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            @* 2. Single One-Off Slot *@
            <div class="card border rounded-3 bg-white mt-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h2 class="h6 card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-clock-plus me-2 text-primary"></i>Add Single 2-Hour Slot
                    </h2>
                </div>
                <div class="card-body p-4">
                    <form action="/Provider/Schedule/CreateTimeSlot" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Date</label>
                            <input type="text" id="NewTimeSlot_Date" name="NewTimeSlot.Date" class="form-control datepicker bg-white" placeholder="Select Date" />
                            <span class="text-danger small">@Html.ValidationMessage("NewTimeSlot.Date")</span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Start Time</label>
                            <input type="text" id="NewTimeSlot_StartTime" name="NewTimeSlot.StartTime" class="form-control timepicker bg-white" placeholder="Select Start Time" />
                            <span class="text-danger small">@Html.ValidationMessage("NewTimeSlot.StartTime")</span>
                            <div class="form-text small">Fixed 2-hour arrival window.</div>
                        </div>

                        <button type="submit" class="btn btn-outline-primary w-100 rounded-pill">
                            <i class="bi bi-plus-circle me-1"></i> Add Slot
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @* ── Right Column: Grouped Time Slots (Upcoming / Past) ── *@
        <div class="col-lg-8">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <ul class="nav nav-pills gap-2">
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 @(!showPast ? "active" : "bg-white border text-dark")"
                           asp-area="Provider" asp-controller="Schedule" asp-action="Index" asp-route-showPast="false">
                            Upcoming (@upcomingCount)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill px-3 @(showPast ? "active" : "bg-white border text-dark")"
                           asp-area="Provider" asp-controller="Schedule" asp-action="Index" asp-route-showPast="true">
                            Past (@pastCount)
                        </a>
                    </li>
                </ul>
            </div>

            @if (!groupedSlots.Any())
            {
                <div class="card border rounded-3 bg-white p-5 text-center text-muted">
                    <i class="bi bi-calendar-x fs-1 mb-2 d-block"></i>
                    @(showPast ? "No past time slots." : "No upcoming time slots yet. Use the Weekly Shift Generator on the left.")
                </div>
            }
            else
            {
                @foreach (var dayGroup in groupedSlots)
                {
                    var hasAvailable = dayGroup.Any(s => s.Status == TimeSlotStatus.Available);
                    <section class="card border rounded-3 bg-white mb-3 overflow-hidden">
                        <div class="card-header bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center">
                            <div class="fw-bold text-dark">
                                <i class="bi bi-calendar-event me-2 text-primary"></i>@dayGroup.Key.ToString("ddd, dd MMM yyyy")
                                <span class="badge bg-light text-secondary border rounded-pill ms-2 fw-normal">@dayGroup.Count() slots</span>
                            </div>
                            @if (!showPast && hasAvailable)
                            {
                                <form action="/Provider/Schedule/ClearDay" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="date" value="@dayGroup.Key.ToString("yyyy-MM-dd")" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" style="min-height: 30px; font-size: .78rem;"
                                            onclick="return confirm('Remove all available slots on @dayGroup.Key.ToString("dd MMM yyyy")? Booked slots will stay.')">
                                        Clear day
                                    </button>
                                </form>
                            }
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 bookings-table">
                                <tbody>
                                    @foreach (var slot in dayGroup)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-medium text-dark">
                                                @DateTime.Today.Add(slot.StartTime).ToString("hh:mm tt") –
                                                @DateTime.Today.Add(slot.EndTime).ToString("hh:mm tt")
                                            </td>
                                            <td>
                                                @switch (slot.Status)
                                                {
                                                    case TimeSlotStatus.Available:
                                                        <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-1">Available</span>
                                                        break;
                                                    case TimeSlotStatus.Locked:
                                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 py-1">Locked</span>
                                                        break;
                                                    case TimeSlotStatus.Booked:
                                                        <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill px-3 py-1">Booked</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                @if (!showPast && slot.Status == TimeSlotStatus.Available)
                                                {
                                                    <form action="/Provider/Schedule/DeleteTimeSlot/@slot.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill"
                                                                onclick="return confirm('Delete this available slot?')">
                                                            <i class="bi bi-trash"></i> Delete
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">@(slot.Status == TimeSlotStatus.Available ? "Past" : "In Use")</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            flatpickr(".datepicker", {
                dateFormat: "Y-m-d",
                minDate: "today"
            });

            flatpickr(".timepicker", {
                enableTime: true,
                noCalendar: true,
                dateFormat: "H:i",
                altInput: true,
                altFormat: "h:i K",
                time_24hr: false
            });
        });
    </script>
}
