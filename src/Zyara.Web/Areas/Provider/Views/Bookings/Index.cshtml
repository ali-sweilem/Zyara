@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Zyara.Domain.Enums
@using Zyara.Services.Features.Bookings.Dtos
@model ProviderBookingsPageDto

@{
    Layout = "_Layout";
    ViewData["Title"] = "Booking Requests";

    string Badge(BookingStatus s) => s switch
    {
        BookingStatus.PendingProviderApproval => "bg-warning text-dark",
        BookingStatus.Confirmed or BookingStatus.ConfirmedCollectionPending => "bg-primary",
        BookingStatus.Started => "bg-info text-dark",
        BookingStatus.Completed => "bg-success",
        _ => "bg-secondary"
    };

    string Label(BookingStatus s) => s switch
    {
        BookingStatus.PendingProviderApproval => "Waiting for you",
        BookingStatus.ConfirmedCollectionPending => "Confirmed",
        _ => s.ToString()
    };

    string When(ProviderBookingItemDto b) =>
        $"{b.Date:ddd, dd MMM yyyy} · {DateTime.Today.Add(b.StartTime):hh:mm tt} – {DateTime.Today.Add(b.EndTime):hh:mm tt}";
}

<div class="container py-4" dir="ltr" lang="en" style="max-width: 1100px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <p class="text-primary fw-semibold small mb-1">Provider Portal</p>
            <h1 class="h3 fw-bold mb-0"><i class="bi bi-calendar2-check me-2 text-primary"></i>Bookings</h1>
        </div>
    </div>

    <ul class="nav nav-pills gap-2 mb-4">
        <li class="nav-item">
            <a class="nav-link active rounded-pill px-4" asp-area="Provider" asp-controller="Bookings" asp-action="Index">
                <i class="bi bi-inbox me-1"></i>Active Requests (@(Model.Pending.Count + Model.Active.Count))
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link bg-white border text-dark rounded-pill px-4" asp-area="Provider" asp-controller="Bookings" asp-action="History">
                <i class="bi bi-clock-history me-1"></i>History
            </a>
        </li>
    </ul>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm">@TempData["Error"]</div>
    }

    @* ───────── 1) waiting for the provider ───────── *@
    <h2 class="h5 fw-bold mb-3">New booking requests <span class="badge bg-warning text-dark">@Model.Pending.Count</span></h2>
    @if (!Model.Pending.Any())
    {
        <p class="text-muted mb-4">No new booking requests.</p>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var b in Model.Pending)
            {
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <div class="fw-bold">@b.PatientName</div>
                                        <span class="badge bg-secondary-subtle text-secondary border small">
                                            <i class="bi bi-shield-lock me-1"></i>Name &amp; phone hidden until accepted
                                        </span>
                                    </div>
                                    <div class="text-muted small">@b.ServiceName · @(b.IsHomeVisit ? "Home visit" : "Remote consultation")</div>
                                </div>
                                <span class="badge @Badge(b.Status) align-self-start">@Label(b.Status)</span>
                            </div>

                            @* Patient Medical Details (Visible Before Acceptance) *@
                            <div class="bg-light p-3 rounded-3 my-3">
                                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                    <span class="fw-semibold small text-dark"><i class="bi bi-clipboard2-pulse me-1 text-primary"></i>Patient Medical Info:</span>
                                    @if (b.PatientAge.HasValue)
                                    {
                                        <span class="badge bg-white text-dark border small">@b.PatientAge yrs</span>
                                    }
                                    @if (b.CareRecipientGender.HasValue)
                                    {
                                        <span class="badge bg-white text-dark border small">@b.CareRecipientGender</span>
                                    }
                                    @if (!string.IsNullOrEmpty(b.BloodTypeDisplay) && b.BloodTypeDisplay != "Unknown")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">
                                            <i class="bi bi-droplet-fill me-1"></i>@b.BloodTypeDisplay
                                        </span>
                                    }
                                </div>
                                <div class="small text-secondary mb-1">
                                    <strong>Conditions:</strong> @(string.IsNullOrWhiteSpace(b.CareRecipientChronicConditions) ? "None" : b.CareRecipientChronicConditions)
                                </div>
                                <div class="small text-secondary mb-1">
                                    <strong>Allergies:</strong>
                                    @if (!string.IsNullOrWhiteSpace(b.CareRecipientAllergies) && b.CareRecipientAllergies != "None")
                                    {
                                        <span class="text-danger fw-semibold"><i class="bi bi-exclamation-triangle-fill me-1"></i>@b.CareRecipientAllergies</span>
                                    }
                                    else
                                    {
                                        <span>None</span>
                                    }
                                </div>
                                <div class="small text-secondary">
                                    <strong>Medications:</strong> @(string.IsNullOrWhiteSpace(b.CareRecipientCurrentMedications) ? "None" : b.CareRecipientCurrentMedications)
                                </div>
                            </div>

                            <div class="my-2 small"><i class="bi bi-clock me-1"></i>@When(b)</div>
                            <div class="small text-muted mb-3">Total: @b.TotalPrice.ToString("0.##") EGP</div>

                            <div class="d-flex gap-2">
                                <form asp-area="Provider" asp-controller="Bookings" asp-action="Accept" asp-route-id="@b.Id" method="post">
                                    <button type="submit" class="btn btn-success rounded-pill px-4">Accept</button>
                                </form>
                                <form asp-area="Provider" asp-controller="Bookings" asp-action="Reject" asp-route-id="@b.Id" method="post"
                                      onsubmit="return confirm('Reject this booking?');">
                                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4">Reject</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* ───────── 2) confirmed / in progress ───────── *@
    <h2 class="h5 fw-bold mb-3">Upcoming &amp; in progress <span class="badge bg-primary">@Model.Active.Count</span></h2>
    @if (!Model.Active.Any())
    {
        <p class="text-muted mb-4">Nothing scheduled right now.</p>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var b in Model.Active)
            {
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <div class="fw-bold">@b.PatientName</div>
                                    <div class="text-muted small">
                                        @b.ServiceName · @(b.IsHomeVisit ? "Home visit" : "Remote consultation")
                                        @if (!string.IsNullOrWhiteSpace(b.PatientPhone)) { <text> · @b.PatientPhone</text> }
                                    </div>
                                </div>
                                <span class="badge @Badge(b.Status) align-self-start">@Label(b.Status)</span>
                            </div>

                            @* Patient Medical Details for visit preparation *@
                            @if (!string.IsNullOrEmpty(b.BloodTypeDisplay) || !string.IsNullOrWhiteSpace(b.CareRecipientAllergies) || !string.IsNullOrWhiteSpace(b.CareRecipientChronicConditions))
                            {
                                <div class="bg-light p-3 rounded-3 my-3 small">
                                    <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
                                        <span class="fw-semibold text-dark"><i class="bi bi-clipboard2-pulse me-1 text-primary"></i>Medical Info:</span>
                                        @if (b.PatientAge.HasValue)
                                        {
                                            <span class="badge bg-white text-dark border">@b.PatientAge yrs</span>
                                        }
                                        @if (b.CareRecipientGender.HasValue)
                                        {
                                            <span class="badge bg-white text-dark border">@b.CareRecipientGender</span>
                                        }
                                        @if (!string.IsNullOrEmpty(b.BloodTypeDisplay) && b.BloodTypeDisplay != "Unknown")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-droplet-fill me-1"></i>@b.BloodTypeDisplay
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(b.CareRecipientAllergies) && b.CareRecipientAllergies != "None")
                                    {
                                        <div class="text-danger fw-semibold"><i class="bi bi-exclamation-triangle-fill me-1"></i>Allergies: @b.CareRecipientAllergies</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(b.CareRecipientChronicConditions) && b.CareRecipientChronicConditions != "None")
                                    {
                                        <div class="text-secondary">Conditions: @b.CareRecipientChronicConditions</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(b.CareRecipientCurrentMedications) && b.CareRecipientCurrentMedications != "None")
                                    {
                                        <div class="text-secondary">Meds: @b.CareRecipientCurrentMedications</div>
                                    }
                                </div>
                            }

                            <div class="my-2 small"><i class="bi bi-clock me-1"></i>@When(b)</div>
                            <div class="small text-muted mb-3">
                                Total: @b.TotalPrice.ToString("0.##") EGP
                                @if (b.PaymentMethod.HasValue)
                                {
                                    <text> · @(b.PaymentMethod == PaymentMethod.CashOnArrival ? "Cash on arrival" : "Paid online")</text>
                                }
                            </div>

                            @if (b.Status == BookingStatus.Started)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    <form asp-area="Provider" asp-controller="Bookings" asp-action="Complete" asp-route-id="@b.Id" method="post">
                                        <button type="submit" class="btn btn-success rounded-pill px-4">Complete visit</button>
                                    </form>
                                    <a asp-area="Provider" asp-controller="MedicalRecords" asp-action="Edit" asp-route-bookingId="@b.Id"
                                       class="btn btn-outline-primary rounded-pill px-4">Visit record</a>
                                </div>
                            }
                            else
                            {
                                <form asp-area="Provider" asp-controller="Bookings" asp-action="Start" asp-route-id="@b.Id" method="post"
                                      class="d-flex flex-wrap gap-2 align-items-center">
                                    @if (b.IsHomeVisit)
                                    {
                                        <input type="text" name="otp" inputmode="numeric" maxlength="6" autocomplete="off"
                                               class="form-control rounded-pill" style="max-width: 170px;"
                                               placeholder="Patient's code" required />
                                    }
                                    <button type="submit" class="btn btn-primary rounded-pill px-4">Start visit</button>
                                </form>
                                @if (b.IsHomeVisit)
                                {
                                    <div class="form-text">Ask the patient for the 4-digit code shown on their booking confirmation.</div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
