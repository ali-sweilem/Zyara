@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Zyara.Domain.Enums
@using Zyara.Services.Common
@using Zyara.Services.Features.Bookings.Dtos
@using Zyara.Services.Features.Shared.Dtos
@model PagedResult<ProviderBookingItemDto>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Bookings History";
    var selected = ViewData["Status"] as BookingStatus?;

    // values that must survive page changes (the page number is added by _Pagination)
    var routeValues = new Dictionary<string, string> { ["area"] = "Provider" };
    if (selected.HasValue) routeValues["status"] = selected.Value.ToString();
    var pagination = new PaginationDto(Model, "History", "Bookings", routeValues, "page", null, "Bookings history pages");

    string Badge(BookingStatus s) => s switch
    {
        BookingStatus.PendingProviderApproval => "bg-warning text-dark",
        BookingStatus.Confirmed or BookingStatus.ConfirmedCollectionPending => "bg-primary",
        BookingStatus.Started => "bg-info text-dark",
        BookingStatus.Completed => "bg-success",
        _ => "bg-secondary"
    };

    string Label(BookingStatus s) => s switch
    {
        BookingStatus.PendingProviderApproval => "Waiting for you",
        BookingStatus.ConfirmedCollectionPending => "Confirmed",
        _ => s.ToString()
    };

    string When(ProviderBookingItemDto b) =>
        $"{b.Date:ddd, dd MMM yyyy} · {DateTime.Today.Add(b.StartTime):hh:mm tt} – {DateTime.Today.Add(b.EndTime):hh:mm tt}";
}

<div class="container-fluid py-4" dir="ltr" lang="en">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 fw-bold mb-0">Bookings History</h1>
    </div>

    <form method="get" asp-area="Provider" asp-controller="Bookings" asp-action="History" class="row g-2 align-items-center mb-3">
        <div class="col-auto">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All statuses</option>
                @foreach (var s in Enum.GetValues<BookingStatus>().Where(x => x != BookingStatus.ConfirmedCollectionPending))
                {
                    <option value="@s" selected="@(selected == s)">@Label(s)</option>
                }
            </select>
        </div>
        <div class="col-auto"><span class="text-muted small">@Model.TotalCount booking(s)</span></div>
        @if (selected.HasValue)
        {
            <div class="col-auto"><a asp-area="Provider" asp-controller="Bookings" asp-action="History" class="small">Clear filter</a></div>
        }
    </form>

    @if (!Model.Items.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-journal-x display-5 d-block mb-2"></i>
            No bookings found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle bg-white shadow-sm rounded-4">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Patient</th>
                        <th>Service</th>
                        <th>When</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Items)
                    {
                        <tr>
                            <td>@b.Id</td>
                            <td>
                                <div class="fw-semibold">@b.PatientName</div>
                                @if (!string.IsNullOrWhiteSpace(b.PatientPhone))
                                {
                                    <div class="text-muted small">@b.PatientPhone</div>
                                }
                            </td>
                            <td>
                                @b.ServiceName
                                <div class="text-muted small">@(b.IsHomeVisit ? "Home visit" : "Remote consultation")</div>
                            </td>
                            <td>@When(b)</td>
                            <td>@b.TotalPrice.ToString("0.##") EGP</td>
                            <td>
                                @if (b.PaymentMethod.HasValue)
                                {
                                    <span>@(b.PaymentMethod == PaymentMethod.CashOnArrival ? "Cash" : "Online")</span>
                                    <div class="text-muted small">@b.PaymentStatus</div>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td><span class="badge @Badge(b.Status)">@Label(b.Status)</span></td>
                            <td>
                                @if (b.Status is BookingStatus.Started or BookingStatus.Completed)
                                {
                                    <a asp-area="Provider" asp-controller="MedicalRecords" asp-action="Edit" asp-route-bookingId="@b.Id"
                                       class="btn btn-sm btn-outline-primary rounded-pill">Visit record</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="pagination" />
    }
</div>
